# Maintainer: DevStarByte <devstarbyte@protonmail.com>
#
# byteforge in the [devstarbyte] pacman repo (DevStarByte/arch-repo): the latest stable ByteForge release.
# Source of truth: packaging/arch-repo/byteforge/PKGBUILD in DevStarByte/ByteForge. The release workflow
# copies it to arch-repo's pkgs/byteforge/ with pkgver set to the tag on every stable tag (vX.Y.Z), and
# arch-repo builds, signs and publishes it. Edit it in ByteForge, not in arch-repo.
# Keep depends/optdepends in sync with packaging/arch/PKGBUILD.
pkgname=byteforge
pkgver=1.0.4  # set by the release workflow
pkgrel=1
pkgdesc="A modular, themeable IDE for C# built with Rust and GPUI"
conflicts=('byteforge-beta')
arch=('x86_64')
url="https://github.com/DevStarByte/ByteForge"
license=('GPL-2.0-only')
depends=('vulkan-icd-loader' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcb'
         'fontconfig' 'freetype2' 'alsa-lib' 'dotnet-sdk' 'curl')
makedepends=('git' 'rust' 'cmake' 'clang' 'pkgconf')
optdepends=('ttf-jetbrains-mono: default editor font'
            'netcoredbg: debugger (AUR)'
            'aspnet-runtime: run ASP.NET Core, Razor and Blazor projects'
            'aspnet-targeting-pack: build ASP.NET Core, Razor and Blazor projects'
            'docker: Docker view'
            'docker-compose: Compose up/down'
            'vulkan-radeon: AMD Vulkan driver'
            'vulkan-intel: Intel Vulkan driver'
            'nvidia-utils: NVIDIA Vulkan driver')
# makepkg's LTO flags turn the C parts (tree-sitter grammars) into GCC LTO objects rust-lld can't link.
options=('!lto' '!debug')
source=("byteforge::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd byteforge
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd byteforge
  # the updater compares against the release version
  BYTEFORGE_VERSION="$pkgver" cargo build --release --frozen -p byteforge
  # The .NET module host
  DOTNET_CLI_TELEMETRY_OPTOUT=1 dotnet publish modulehost/ByteForge.ModuleHost.csproj -c Release -o "$srcdir/modulehost" -nologo
}

package() {
  cd byteforge
  install -Dm755 target/release/byteforge "$pkgdir/usr/lib/byteforge/byteforge"
  install -dm755 "$pkgdir/usr/lib/byteforge/themes"
  install -m644 themes/*.json "$pkgdir/usr/lib/byteforge/themes/"
  cp -r --no-preserve=ownership "$srcdir/modulehost" "$pkgdir/usr/lib/byteforge/modulehost"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /usr/lib/byteforge/byteforge "$pkgdir/usr/bin/byteforge"
  install -Dm644 packaging/linux/byteforge.desktop "$pkgdir/usr/share/applications/byteforge.desktop"
  install -Dm644 packaging/linux/byteforge.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/byteforge.svg"
  local size
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 packaging/linux/icons/byteforge-$size.png \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/byteforge.png"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/byteforge/README.md"
}
