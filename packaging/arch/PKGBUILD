# Maintainer: DevStarByte <devstarbyte@protonmail.com>
#
# Builds a package from this local checkout (no download):
#   cd packaging/arch && makepkg -si      # build and install
#   makepkg -sfi                          # rebuild and reinstall after pulling changes
# The cargo build lives in ./src/target, so later builds are incremental; `makepkg -C` starts clean.
pkgname=byteforge
pkgver=0.3.1  # keep in sync with Cargo.toml [workspace.package] version
pkgrel=1
pkgdesc="A modular, themeable IDE for C# built with Rust and GPUI"
arch=('x86_64' 'aarch64')
url="https://github.com/DevStarByte/ByteForge"
license=('MIT')
depends=('vulkan-icd-loader' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcb'
         'fontconfig' 'freetype2' 'alsa-lib' 'dotnet-sdk' 'curl')
makedepends=('rust' 'cmake' 'clang' 'pkgconf')
optdepends=('ttf-jetbrains-mono: default editor font'
            'netcoredbg: debugger (AUR)'
            'aspnet-runtime: run ASP.NET Core, Razor and Blazor projects'
            'aspnet-targeting-pack: build ASP.NET Core, Razor and Blazor projects'
            'docker: Docker view'
            'docker-compose: Compose up/down'
            'python: CSharpier formatter module'
            'vulkan-radeon: AMD Vulkan driver'
            'vulkan-intel: Intel Vulkan driver'
            'nvidia-utils: NVIDIA Vulkan driver')
# makepkg's LTO flags turn the C parts (tree-sitter grammars) into GCC LTO objects rust-lld can't link.
options=('!lto' '!debug')

_root() { realpath "$startdir/../.."; }

build() {
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked -p byteforge --manifest-path "$(_root)/Cargo.toml"
}

package() {
  local root; root=$(_root)
  install -Dm755 "$srcdir/target/release/byteforge" "$pkgdir/usr/lib/byteforge/byteforge"
  install -dm755 "$pkgdir/usr/lib/byteforge/themes"
  install -m644 "$root"/themes/*.json "$pkgdir/usr/lib/byteforge/themes/"
  cp -r --no-preserve=ownership "$root/modules" "$pkgdir/usr/lib/byteforge/modules"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /usr/lib/byteforge/byteforge "$pkgdir/usr/bin/byteforge"
  install -Dm644 "$root/packaging/linux/byteforge.desktop" "$pkgdir/usr/share/applications/byteforge.desktop"
  install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/byteforge/README.md"
}
