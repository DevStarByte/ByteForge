{
  // GitHub for ByteForge: the pipelines (GitHub Actions), pull requests, issues and releases of the folder's
  // GitHub repository. Talks to the GitHub REST API directly. (Called "GitHub Actions" up to 0.1.0.)
  "id": "byteforge.github-actions",
  "name": "GitHub",
  "version": "0.2.0",
  "author": "DevStarByte",
  "authorUrl": "https://github.com/DevStarByte",
  "category": "Source Control",
  "description": "A GitHub view for the folder's repository. Pipelines: the current branch's workflow runs and every workflow's latest runs with state, trigger, age and duration (refreshed while runs are going; the badge counts them); click a run for its jobs and steps, a job for its log in an editor at the first error; re-run, re-run failed jobs, cancel, \"GitHub: Run Workflow\u2026\". Pull requests: the open ones (the current branch's first), click for their checks (an Actions check opens its log), Check Out, Open in Browser. Issues: the open ones (yours first), \"Create Branch\" (feature/123-title). Releases: the latest five with their downloads. The status bar shows the branch's latest run and its pull request with the checks' state. Public repositories work without a token; logs, re-running, cancelling, starting workflows and private repositories need one (\"github.token\", GH_TOKEN, or a logged-in gh). Needs python3 and git.",
  "command": "python3",
  "args": ["github_actions.py"],
  "requires": ["git"],
  "settings": [
    {"key": "github.token", "title": "Token", "type": "string", "default": "",
     "description": "A GitHub token (fine-grained: Actions read and write; Contents, Pull requests and Issues read) for private repositories, re-running, cancelling and starting workflows, and 5000 requests an hour. Empty: GH_TOKEN, GITHUB_TOKEN or gh's login. It's stored in settings.json as plain text."},
    {"key": "github.refreshSeconds", "title": "Refresh every (seconds)", "type": "number", "default": 60,
     "description": "How often runs are checked while one is going (five times as long otherwise; at least 240 without a token). Pull requests, issues and releases every third time."},
    {"key": "github.showStatus", "title": "Show the latest run in the status bar", "type": "boolean", "default": true,
     "description": "The current branch's latest run and its pull request, with their state. Off also stops refreshing while the view is hidden."},
    {"key": "github.branchName", "title": "Branch name for an issue", "type": "string", "default": "feature/{number}-{title}",
     "description": "What \"Create Branch\" on an issue calls the branch: {number} is the issue number, {title} its title in lower case with dashes."}
  ],
  "views": [
    {
      "id": "github-actions",
      "title": "GitHub",
      "icon": "M12,2A10,10 0 1,0 12,22A10,10 0 1,0 12,2Z M12,4A8,8 0 1,1 12,20A8,8 0 1,1 12,4Z M10,8V16L16,12Z"
    }
  ]
}
