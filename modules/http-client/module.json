{
  // HTTP Client for ByteForge: sends the requests in .http / .rest files (the format Visual Studio, Rider and
  // VS Code's REST Client share) and opens each response in an editor.
  "id": "byteforge.http-client",
  "name": "HTTP Client",
  "version": "0.1.0",
  "author": "DevStarByte",
  "authorUrl": "https://github.com/DevStarByte",
  "category": "Web",
  "description": "Sends the requests in .http and .rest files, the format Visual Studio and Rider use for ASP.NET Core APIs: an HTTP view lists every request in the workspace (click to send), \"HTTP: Send Request…\" (Ctrl+Alt+Enter) picks one from the active file, \"Send All Requests in File\" sends them in order. Variables (@host = …), environments from http-client.env.json and http-client.private.env.json (pick one in the status bar), values from earlier responses ({{login.response.body.$.token}}), {{$guid}}, {{$timestamp}}, {{$datetime …}}, {{$processEnv NAME}} and {{$dotenv NAME}}. Each response opens in an editor with its status, headers, timing and pretty-printed JSON. Highlighting and a file icon for .http files. Needs python3.",
  "command": "python3",
  "args": ["http_client.py"],
  "settings": [
    {"key": "http.environment", "title": "Environment", "type": "string", "default": "",
     "description": "The http-client.env.json environment to use at start (empty: dev, development or local if there is one, else the first). The status bar item changes it for the session."},
    {"key": "http.timeout", "title": "Timeout (seconds)", "type": "number", "default": 30,
     "description": "How long to wait for a response."},
    {"key": "http.followRedirects", "title": "Follow redirects", "type": "boolean", "default": true,
     "description": "Follow 3xx redirects; off shows the redirect response itself."},
    {"key": "http.prettyPrint", "title": "Pretty-print JSON", "type": "boolean", "default": true,
     "description": "Indent JSON response bodies."},
    {"key": "http.insecureLocalhost", "title": "Accept any certificate on localhost", "type": "boolean", "default": true,
     "description": "Don't check HTTPS certificates of localhost (the ASP.NET Core development certificate often isn't trusted on Linux). Other hosts are always checked unless the next setting is off."},
    {"key": "http.verifyCertificates", "title": "Check HTTPS certificates", "type": "boolean", "default": true,
     "description": "Off accepts any certificate on every host. Only for test servers you trust."}
  ],
  "views": [
    {
      "id": "http",
      "title": "HTTP",
      "icon": "M4,6H20V8H4Z M4,11H14V13H4Z M4,16H11V18H4Z M15,12L21,16L15,20Z"
    }
  ],
  "fileIcons": [
    {
      "icon": "M6,2H14L20,8V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2Z M14,3.5V8H18.5Z M7,12H17V13.5H7Z M7,15.5H13V17H7Z M14.5,14.5L18,16.25L14.5,18Z",
      "color": "#3fa65b",
      "extensions": ["http", "rest"],
      "names": ["http-client.env.json", "http-client.private.env.json"]
    }
  ],
  "languages": [
    {
      "id": "http",
      "name": "HTTP",
      "extensions": ["http", "rest"],
      "lineComment": "#",
      "detect": [
        "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\\s+(https?://|\\{\\{)\\S*(\\s+HTTP/\\d(\\.\\d)?)?\\s*$",
        "^###",
        "^@[A-Za-z_][\\w.-]*\\s*=",
        "^(Content-Type|Authorization|Accept):\\s"
      ],
      // Applied per line; where matches overlap, the earlier rule wins.
      "rules": [
        {"match": "^###.*$", "token": "comment"},
        {"match": "^\\s*(?:#|//)\\s*(@name)\\b\\s*=?\\s*(\\S*)", "group": 1, "token": "keyword"},
        {"match": "^\\s*(?:#|//)\\s*@name\\b\\s*=?\\s*(\\S*)", "group": 1, "token": "label name"},
        {"match": "^\\s*(?:#|//).*$", "token": "comment"},
        {"match": "\\{\\{\\s*\\$[\\w.]+[^}]*\\}\\}", "token": "method name"},
        {"match": "\\{\\{[^}]*\\}\\}", "token": "parameter name"},
        {"match": "^(@)([A-Za-z_][\\w.-]*)\\s*=", "group": 2, "token": "local name"},
        {"match": "^(@)[A-Za-z_][\\w.-]*\\s*=", "group": 1, "token": "operator"},
        {"match": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|TRACE|CONNECT)\\b", "group": 1, "token": "keyword - control"},
        {"match": "\\bHTTP/\\d(?:\\.\\d)?\\b", "token": "keyword"},
        {"match": "^HTTP/\\d(?:\\.\\d)?\\s+(\\d{3})\\b", "group": 1, "token": "number"},
        {"match": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|TRACE|CONNECT)\\s+(\\S+)", "group": 2, "token": "string"},
        {"match": "^(https?://\\S+)", "group": 1, "token": "string"},
        {"match": "^\\s*[?&]([^=&\\s]+)", "group": 1, "token": "property name"},
        {"match": "^([!#$%&'*+.^_`|~0-9A-Za-z-]+):\\s", "group": 1, "token": "type"},
        {"match": "^\\s*(<@?)\\s+\\S.*$", "group": 1, "token": "operator"},
        {"match": "(\"(?:[^\"\\\\]|\\\\.)*\")\\s*:", "group": 1, "token": "property name"},
        {"match": "\"(?:[^\"\\\\]|\\\\.)*\"?", "token": "string"},
        {"match": "\\b(true|false|null)\\b", "group": 1, "token": "keyword"},
        {"match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b", "token": "number"},
        {"match": "[{}\\[\\],:]", "token": "punctuation"}
      ]
    }
  ]
}
