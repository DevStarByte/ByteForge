 },
 "dockerfileTexts": {
  "<ws>/Api/Api.csproj": "# Build:  docker build -f Api/Dockerfile -t api .\n# (run from the build context: the folder that contains the solution)\n\nFROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base\nUSER $APP_UID\nWORKDIR /app\nEXPOSE 8080\nEXPOSE 8081\n\nFROM mcr.microsoft.com/dotnet/sdk:9.0 AS build\nARG BUILD_CONFIGURATION=Release\nWORKDIR /src\nCOPY [\"Directory.Build.props\", \".\"]\nCOPY [\"Api/Api.csproj\", \"Api/\"]\nCOPY [\"Core/Core.csproj\", \"Core/\"]\nCOPY [\"Lib/Lib.csproj\", \"Lib/\"]\nRUN dotnet restore \"./Api/Api.csproj\"\nCOPY . .\nWORKDIR \"/src/Api\"\nRUN dotnet build \"./Api.csproj\" -c $BUILD_CONFIGURATION -o /app/build\n\nFROM build AS publish\nARG BUILD_CONFIGURATION=Release\nRUN dotnet publish \"./Api.csproj\" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false\n\nFROM base AS final\nWORKDIR /app\nCOPY --from=publish /app/publish .\nENTRYPOINT [\"dotnet\", \"Api.dll\"]\n",
  "<ws>/Core/Core.csproj": "# Build:  docker build -f Core/Dockerfile -t core .\n# (run from the build context: the folder that contains the solution)\n\nFROM mcr.microsoft.com/dotnet/runtime:8.0 AS base\nUSER $APP_UID\nWORKDIR /app\n\nFROM mcr.microsoft.com/dotnet/sdk:8.0 AS build\nARG BUILD_CONFIGURATION=Release\nWORKDIR /src\nCOPY [\"Directory.Build.props\", \".\"]\nCOPY [\"Core/Core.csproj\", \"Core/\"]\nRUN dotnet restore \"./Core/Core.csproj\"\nCOPY . .\nWORKDIR \"/src/Core\"\nRUN dotnet build \"./Core.csproj\" -c $BUILD_CONFIGURATION -o /app/build\n\nFROM build AS publish\nARG BUILD_CONFIGURATION=Release\nRUN dotnet publish \"./Core.csproj\" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false\n\nFROM base AS final\nWORKDIR /app\nCOPY --from=publish /app/publish .\nENTRYPOINT [\"dotnet\", \"Core.dll\"]\n",
  "<ws>/Lib/Lib.csproj": "# Build:  docker build -f Lib/Dockerfile -t lib .\n# (run from the build context: the folder that contains the solution)\n\nFROM mcr.microsoft.com/dotnet/runtime:10.0 AS base\nUSER $APP_UID\nWORKDIR /app\n\nFROM mcr.microsoft.com/dotnet/sdk:10.0 AS build\nARG BUILD_CONFIGURATION=Release\nWORKDIR /src\nCOPY [\"Directory.Build.props\", \".\"]\nCOPY [\"Lib/Lib.csproj\", \"Lib/\"]\nCOPY [\"Core/Core.csproj\", \"Core/\"]\nRUN dotnet restore \"./Lib/Lib.csproj\"\nCOPY . .\nWORKDIR \"/src/Lib\"\nRUN dotnet build \"./Lib.csproj\" -c $BUILD_CONFIGURATION -o /app/build\n\nFROM build AS publish\nARG BUILD_CONFIGURATION=Release\nRUN dotnet publish \"./Lib.csproj\" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false\n\nFROM base AS final\nWORKDIR /app\nCOPY --from=publish /app/publish .\nENTRYPOINT [\"dotnet\", \"Lib.dll\"]\n",
  "<ws>/Tool/Tool.csproj": "# Build:  docker build -f Tool/Dockerfile -t tool .\n# (run from the build context: the folder that contains the solution)\n\nFROM mcr.microsoft.com/dotnet/runtime:10.0 AS base\nUSER $APP_UID\nWORKDIR /app\n\nFROM mcr.microsoft.com/dotnet/sdk:10.0 AS build\nARG BUILD_CONFIGURATION=Release\nWORKDIR /src\nCOPY [\"Directory.Build.props\", \".\"]\nCOPY [\"Tool/Tool.csproj\", \"Tool/\"]\nRUN dotnet restore \"./Tool/Tool.csproj\"\nCOPY . .\nWORKDIR \"/src/Tool\"\nRUN dotnet build \"./Tool.csproj\" -c $BUILD_CONFIGURATION -o /app/build\n\nFROM build AS publish\nARG BUILD_CONFIGURATION=Release\nRUN dotnet publish \"./Tool.csproj\" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false\n\nFROM base AS final\nWORKDIR /app\nCOPY --from=publish /app/publish .\nENTRYPOINT [\"dotnet\", \"Tool.dll\"]\n",
  "<ws>/src/Worker/Worker.csproj": "# Build:  docker build -f src/Worker/Dockerfile -t my.worker_service .\n# (run from the build context: the folder that contains the solution)\n\nFROM mcr.microsoft.com/dotnet/runtime:10.0 AS base\nUSER $APP_UID\nWORKDIR /app\n\nFROM mcr.microsoft.com/dotnet/sdk:10.0 AS build\nARG BUILD_CONFIGURATION=Release\nWORKDIR /src\nCOPY [\"Directory.Build.props\", \".\"]\nCOPY [\"src/Worker/Worker.csproj\", \"src/Worker/\"]\nRUN dotnet restore \"./src/Worker/Worker.csproj\"\nCOPY . .\nWORKDIR \"/src/src/Worker\"\nRUN dotnet build \"./Worker.csproj\" -c $BUILD_CONFIGURATION -o /app/build\n\nFROM build AS publish\nARG BUILD_CONFIGURATION=Release\nRUN dotnet publish \"./Worker.csproj\" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false\n\nFROM base AS final\nWORKDIR /app\nCOPY --from=publish /app/publish .\nENTRYPOINT [\"dotnet\", \"My.Worker_Service.dll\"]\n"
 },
