  "languages": [
    {
      "id": "dockerfile",
      "name": "Dockerfile",
      "names": ["Dockerfile", "Containerfile"],
      "patterns": ["Dockerfile.*", "Containerfile.*"],
      "extensions": ["dockerfile", "containerfile"],
      "lineComment": "#",
      // Applied per line; where matches overlap, the earlier rule wins.
      "rules": [
        {"match": "^\\s*#.*$", "token": "comment"},
        {"match": "\\\\\\s*$", "token": "operator"},
        {"match": "<<-?[\"']?[A-Za-z_][A-Za-z0-9_]*[\"']?", "token": "label name"},
        {"match": "\"\\s*(,)\\s*\"", "group": 1, "token": "punctuation"},
        {"match": "^\\s*[A-Za-z]+\\s+(?:--\\S+\\s+)*(\\[)", "group": 1, "token": "punctuation"},
        {"match": "(\\])\\s*$", "group": 1, "token": "punctuation"},
        {"match": "\\$\\{[A-Za-z_][A-Za-z0-9_]*(:?[-+?=]|##?|%%?)", "group": 1, "token": "operator"},
        {"match": "\\$\\{[^}]*\\}?|\\$[A-Za-z_][A-Za-z0-9_]*", "token": "local name"},
        {"match": "\\\\[\\\\\"'$nrt]", "token": "string - escape character"},
        {"match": "\"(?:[^\"\\\\]|\\\\.)*\"?", "token": "string"},
        {"match": "'(?:[^'\\\\]|\\\\.)*'?", "token": "string"},
        {"match": "(?i)^\\s*(FROM|RUN|CMD|LABEL|EXPOSE|ENV|ADD|COPY|ENTRYPOINT|VOLUME|USER|WORKDIR|ARG|ONBUILD|STOPSIGNAL|HEALTHCHECK|SHELL|MAINTAINER|CROSS_BUILD)\\b", "group": 1, "token": "keyword"},
        {"match": "(?i)^\\s*ONBUILD\\s+(FROM|RUN|CMD|LABEL|EXPOSE|ENV|ADD|COPY|ENTRYPOINT|VOLUME|USER|WORKDIR|ARG|ONBUILD|STOPSIGNAL|HEALTHCHECK|SHELL|MAINTAINER|CROSS_BUILD)\\b", "group": 1, "token": "keyword"},
        {"match": "(?i)^\\s*HEALTHCHECK\\s+(?:--\\S+\\s+)*(CMD|NONE)\\b", "group": 1, "token": "keyword"},
        {"match": "(?i)^\\s*(?:ONBUILD\\s+)?[A-Za-z]+\\s+(--[A-Za-z][\\w-]*(?:=\\S*)?(?:\\s+--[A-Za-z][\\w-]*(?:=\\S*)?)*)", "group": 1, "token": "parameter name"},
        {"match": "(?i)^\\s*FROM\\s+(?:--\\S+\\s+)*\\S+\\s+(AS)\\b", "group": 1, "token": "keyword"},
        {"match": "(?i)^\\s*FROM\\s+(?:--\\S+\\s+)*\\S+\\s+AS\\s+(\\S+)", "group": 1, "token": "label name"},
        {"match": "(?i)^\\s*FROM\\s+(?:--\\S+\\s+)*([^\\s:@]+(?::\\d+/[^\\s:@]+)?)", "group": 1, "token": "class name"},
        {"match": "(?i)^\\s*FROM\\s+(?:--\\S+\\s+)*[^\\s:@]+(?::\\d+/[^\\s:@]+)?(:[^\\s@]+)", "group": 1, "token": "number"},
        {"match": "(?i)^\\s*FROM\\s+(?:--\\S+\\s+)*[^\\s@]*(@\\S+)", "group": 1, "token": "number"},
        {"match": "(?i)^\\s*(?:ARG|ENV)\\s+([A-Za-z_][A-Za-z0-9_.-]*)", "group": 1, "token": "property name"},
        {"match": "(?i)^\\s*LABEL\\s+([^\\s=\"']+)", "group": 1, "token": "property name"},
        {"match": "(?i)^\\s*EXPOSE\\s+((?:\\d+(?:-\\d+)?(?:/[A-Za-z]+)?\\s*)+)", "group": 1, "token": "number"},
        {"match": "(?i)^\\s*(?:STOPSIGNAL|USER)\\s+(\\d+)\\b", "group": 1, "token": "number"}
      ]
    }
  ]
}
