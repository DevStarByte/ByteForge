{
  // macOS Theme for ByteForge: a theme that looks like macOS and follows System Settings live.
  "id": "byteforge.macos-theme",
  "name": "macOS Theme",
  "version": "0.1.0",
  "author": "DevStarByte",
  "authorUrl": "https://github.com/DevStarByte",
  "category": "Themes",
  "description": "A theme that looks like macOS and follows your Mac's settings live: Light or Dark appearance (Auto too), the accent color in selections, buttons and menus, Reduce Transparency and Increase Contrast. A translucent sidebar and title bar (vibrancy), Xcode's Default (Dark) and Default (Light) syntax colors, SF Pro and SF Mono, rounded controls. \"macOS Theme: Use macOS Theme\" switches to it (it's chosen once when installed). Works on other systems too, with the appearance and accent from its settings. Needs python3.",
  "command": "python3",
  "args": ["macos_theme.py"],
  "settings": [
    {"key": "macosTheme.appearance", "title": "Appearance", "type": "string", "choices": ["system", "dark", "light"],
     "default": "system", "description": "Light or Dark: system follows macOS (Auto included)."},
    {"key": "macosTheme.accent", "title": "Accent color", "type": "string",
     "choices": ["system", "blue", "purple", "pink", "red", "orange", "yellow", "green", "graphite"],
     "default": "system", "description": "The accent: system follows the one in System Settings > Appearance."},
    {"key": "macosTheme.translucent", "title": "Translucent sidebar and title bar", "type": "boolean", "default": true,
     "description": "Let the desktop show through the sidebar and title bar, like Finder. Always off with Reduce Transparency."}
  ]
}
