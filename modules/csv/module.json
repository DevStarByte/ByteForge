{
  // CSV for ByteForge: rainbow columns for .csv / .tsv files (one color per column; the rules are generated by
  // tests/CsvTests.cs, and BYTEFORGE_WRITE_RULES=1 dotnet test rewrites them), a CSV view with the columns of the
  // active file, Show as Table and Convert to JSON.
  "id": "byteforge.csv",
  "name": "CSV",
  "version": "0.2.0",
  "author": "DevStarByte",
  "authorUrl": "https://github.com/DevStarByte",
  "category": "Languages",
  "description": "Rainbow columns for .csv, .tsv and .psv files: each column in its own color (20 columns, then the colors repeat), quoted fields kept together, and semicolon files as Excel writes them in Germany or France split at the semicolons. A CSV view lists the active file's columns with their type (integer, decimal, date, boolean, text), range, empty and distinct values; the separator, header row, decimal commas and ANSI files are recognized by themselves. \"CSV: Show as Table\" opens an aligned table (numbers right-aligned), \"CSV: Convert to JSON\" an array of objects with numbers and booleans as JSON values. Needs .NET 10.",
  "runtime": "dotnet",
  "assembly": "bin/Csv.dll",
  "views": [
    {"id": "csv", "title": "CSV", "icon": "M3,4H21V20H3Z M5,6V9H11V6Z M13,6V9H19V6Z M5,11V14H11V11Z M13,11V14H19V11Z M5,16V18H11V16Z M13,16V18H19V16Z"}
  ],
  "fileIcons": [
    {
      "icon": "M6,2H14L20,8V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2Z M14,3.5V8H18.5Z M7,11H11V13H7Z M12,11H17V13H12Z M7,14.5H11V16.5H7Z M12,14.5H17V16.5H12Z M7,18H11V19.5H7Z M12,18H17V19.5H12Z",
      "color": "#21a366",
      "extensions": ["csv", "tsv", "tab", "psv"]
    }
  ],
  "languages": [
    {
      "id": "csv",
      "name": "CSV",
      "extensions": ["csv", "tsv", "tab", "psv"],
