{
  // Accessibility theme: pure black, white text, and every boundary drawn as a solid line. Focus is a bright
  // yellow, selection a strong blue, errors red and warnings orange, all well above WCAG AAA contrast on
  // black. No transparency, no gradients, no blinking caret, thicker borders, a wider caret, a slightly larger
  // interface font and straight squiggles that are easier to see than wavy ones.
  "name": "High Contrast",
  "type": "dark",
  "inherits": "ByteForge Dark",
  "description": "Black and white, solid borders, strong focus",

  "colors": {
    "accent": "#ffd400",
    "focusBorder": "#ffd400",
    "window.background": "#000000",
    "window.foreground": "#ffffff",
    "foreground.muted": "#d0d0d0",
    "icon.foreground": "#ffffff",
    "overlay.background": "#000000c0",
    "toolbar.hoverBackground": "#1f1f1f",
    "sash.hoverBorder": "#ffd400",

    "titleBar.background": "#000000",
    "titleBar.foreground": "#ffffff",
    "titleBar.inactiveForeground": "#d0d0d0",
    "titleBar.border": "#ffffff",
    "titleBar.logo": "#ffd400",
    "commandCenter.background": "#000000",
    "commandCenter.foreground": "#ffffff",
    "commandCenter.border": "#ffffff",
    "commandCenter.hoverBorder": "#ffd400",
    "commandCenter.hoverBackground": "#1f1f1f",
    "windowControl.hoverBackground": "#1f1f1f",
    "windowControl.closeHoverBackground": "#ff4040",
    "windowControl.closeHoverForeground": "#000000",
    "menu.background": "#000000",
    "menu.foreground": "#ffffff",
    "menu.selectionBackground": "#0050c8",
    "menu.border": "#ffffff",

    "activityBar.background": "#000000",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#c0c0c0",
    "activityBar.activeBorder": "#ffd400",
    "activityBar.activeBackground": "#1f1f1f",
    "activityBar.hoverBackground": "#1f1f1f",
    "activityBar.border": "#ffffff",
    "activityBarBadge.background": "#ffd400",
    "activityBarBadge.foreground": "#000000",
    "badge.background": "#ffd400",
    "badge.foreground": "#000000",

    "sideBar.background": "#000000",
    "sideBar.foreground": "#ffffff",
    "sideBar.border": "#ffffff",
    "sideBarTitle.foreground": "#ffffff",
    "sideBarSectionHeader.foreground": "#ffd400",
    "list.hoverBackground": "#1f1f1f",
    "list.activeSelectionBackground": "#0050c8",
    "list.activeSelectionForeground": "#ffffff",
    "list.activeFileBackground": "#0050c8",
    "list.activeFileForeground": "#ffffff",
    "list.activeFileIndicator": "#ffd400",
    "icon.folder": "#ffd400",
    "icon.csharp": "#c8a0ff",
    "icon.project": "#40e0ff",
    "icon.json": "#ffd400",
    "icon.markdown": "#40e0ff",

    "editorGroupHeader.background": "#000000",
    "editorGroupHeader.border": "#ffffff",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#c0c0c0",
    "tab.hoverBackground": "#1f1f1f",
    "tab.border": "#ffffff",
    "tab.activeBorderTop": "#ffd400",
    "tab.modifiedIndicator": "#ffd400",
    "breadcrumb.background": "#000000",
    "breadcrumb.foreground": "#d0d0d0",
    "breadcrumb.activeForeground": "#ffffff",

    "editor.background": "#000000",
    "editor.foreground": "#ffffff",
    "editorGutter.background": "#000000",
    "editor.lineHighlightBackground": "#000000",
    "editor.lineHighlightBorder": "#ffffff",
    "editor.selectionBackground": "#0050c8",
    "editor.inactiveSelectionBackground": "#003a90",
    "editor.findMatchBackground": "#000000",
    "editor.findMatchBorder": "#ff9a00",
    "editor.wordHighlightBackground": "#000000",
    "editor.wordHighlightBorder": "#40e0ff",
    "editorInlayHint.foreground": "#d0d0d0",
    "editorInlayHint.background": "#1f1f1f",
    "editorCursor.foreground": "#ffd400",
    "editorCursor.background": "#000000",
    "editorLineNumber.foreground": "#c0c0c0",
    "editorLineNumber.activeForeground": "#ffd400",
    "editorIndentGuide.background": "#707070",
    "editorWhitespace.foreground": "#707070",
    "editorRuler.foreground": "#707070",
    "editorBracketMatch.background": "#000000",
    "editorBracketMatch.border": "#ffd400",
    "editorBracketHighlight.foreground1": "#ffd400",
    "editorBracketHighlight.foreground2": "#40e0ff",
    "editorBracketHighlight.foreground3": "#ff80ff",
    "editorBracketHighlight.unexpectedBracket.foreground": "#ff4040",
    "editorError.foreground": "#ff4040",
    "editorWarning.foreground": "#ff9a00",
    "editorInfo.foreground": "#40e0ff",
    "errorForeground": "#ff4040",
    "editorWidget.background": "#000000",
    "editorWidget.border": "#ffffff",
    "editorStickyScroll.border": "#ffffff",

    "panel.background": "#000000",
    "panel.border": "#ffffff",
    "panelTitle.activeBorder": "#ffd400",
    "problemsErrorIcon.foreground": "#ff4040",
    "problemsWarningIcon.foreground": "#ff9a00",

    "statusBar.background": "#000000",
    "statusBar.foreground": "#ffffff",
    "statusBar.border": "#ffffff",
    "statusBarItem.branch.foreground": "#ffd400",

    "input.background": "#000000",
    "input.border": "#ffffff",
    "button.background": "#000000",
    "button.foreground": "#ffffff",
    "button.border": "#ffd400",
    "button.hoverBackground": "#1f1f1f",
    "quickInput.background": "#000000",
    "quickInput.border": "#ffd400",
    "scrollbarSlider.background": "#a0a0a0",
    "scrollbarSlider.hoverBackground": "#ffffff",
    "welcome.logo": "#ffffff30",
    "welcome.titleForeground": "#ffffff",

    "gitDecoration.addedResourceForeground": "#60ff60",
    "gitDecoration.modifiedResourceForeground": "#40e0ff",
    "gitDecoration.deletedResourceForeground": "#ff4040",
    "editorGutter.addedBackground": "#60ff60",
    "editorGutter.modifiedBackground": "#40e0ff",
    "editorGutter.deletedBackground": "#ff4040",
    "diffEditor.insertedLineBackground": "#00500080",
    "diffEditor.removedLineBackground": "#60000080",
    "settings.modifiedIndicator": "#ffd400",
    "settings.rowBorder": "#707070"
  },

  "tokenColors": {
    "keyword": "#40c8ff",
    "keyword - control": "#ff80ff",
    "preprocessor keyword": "#d0d0d0",
    "comment": { "foreground": "#7fe07f", "fontStyle": "italic" },
    "xml doc comment": { "foreground": "#7fe07f", "fontStyle": "italic" },
    "excluded code": "#a0a0a0",
    "string": "#ffb070",
    "string - verbatim": "#ffb070",
    "string - escape character": "#ffd400",
    "number": "#c0ffa0",
    "operator": "#ffffff",
    "punctuation": "#ffffff",
    "identifier": "#ffffff",
    "namespace name": "#ffffff",
    "class name": "#40ffd0",
    "record class name": "#40ffd0",
    "struct name": "#40ffd0",
    "record struct name": "#40ffd0",
    "interface name": "#a0ffe0",
    "enum name": "#a0ffe0",
    "delegate name": "#40ffd0",
    "type parameter name": "#a0ffe0",
    "method name": "#ffff80",
    "extension method name": "#ffff80",
    "property name": "#a0e0ff",
    "field name": "#a0e0ff",
    "event name": "#a0e0ff",
    "local name": "#ffffff",
    "parameter name": "#ffffff",
    "constant name": "#80c0ff",
    "enum member name": "#80c0ff",
    "json - property name": "#a0e0ff",
    "json - string": "#ffb070",
    "html element name": "#40c8ff",
    "html attribute name": "#a0e0ff",
    "html attribute value": "#ffb070",
    "html tag delimiter": "#ffffff",
    "markup heading": { "foreground": "#ffd400", "fontStyle": "bold" },
    "markup code": "#ffb070",
    "markup link": { "foreground": "#40e0ff", "fontStyle": "underline" }
  },

  "fonts": {
    "ui.size": 14,
    "ui.smallSize": 12,
    "tab.fontSize": 14,
    "list.fontSize": 14,
    "statusBar.fontSize": 13,
    "tab.activeWeight": "bold",
    "editor.size": 15
  },

  "metrics": {
    "activityBar.indicatorLeft.border": "3,0,0,0",
    "tab.indicatorSize": 3,
    "tab.borderThickness": "0,0,1,0",
    "editorWidget.borderThickness": 2,
    "quickInput.borderThickness": 2,
    "input.borderThickness": 2,
    "button.borderThickness": 2,
    "commandCenter.borderThickness": 2,
    "scrollbar.size": 14,
    "editor.caretWidth": 3,
    "editorGutter.changeWidth": 4
  },

  "editor": {
    "cursorBlinking": "solid",
    "cursorWidth": 3,
    "smoothCaretAnimation": false,
    "lineHighlight": "border",
    "lineHighlightBorderWidth": 1,
    "squiggleStyle": "line",
    "indentGuideWidth": 1
  },

  "effects": {
    "window.backdrop": "none",
    "palette.shadow": "none",
    "widget.shadow": "none"
  },

  "layout": {
    "tab.indicatorPosition": "top"
  }
}
