{
  // Looks like Neovim 0.10+ with its default colorscheme (the Nvim* palette): no activity bar, a file tree
  // without header, buffer tabs, a lualine-style status line with a colored mode block, block cursor,
  // monospace everywhere and square corners. Use the keyboard like in Neovim: Ctrl+P files,
  // Ctrl+Shift+F grep, Ctrl+Shift+G git, Ctrl+B tree, Ctrl+J quickfix-like panel.
  //
  // Palette: DarkGrey1 #07080d  DarkGrey2 #14161b  DarkGrey3 #2c2e33  DarkGrey4 #4f5258
  //          LightGrey1 #eef1f8 LightGrey2 #e0e2ea LightGrey3 #c4c6cd LightGrey4 #9b9ea4
  //          Blue #a6dbff/#004c73  Cyan #8cf8f7/#007373  Green #b3f6c0/#005523
  //          Magenta #ffcaff/#470045  Red #ffc0b9/#590008  Yellow #fce094/#6b5300
  "name": "Neovim",
  "type": "dark",
  "inherits": "ByteForge Dark",
  "description": "Neovim's default look: lualine, buffer tabs, block cursor, monospace",

  "colors": {
    "accent": "#a6dbff",
    "focusBorder": "#4f5258",
    "window.background": "#14161b",
    "window.foreground": "#e0e2ea",
    "foreground.muted": "#9b9ea4",
    "icon.foreground": "#c4c6cd",
    "overlay.background": "#07080d80",
    "toolbar.hoverBackground": "#2c2e33",
    "sash.hoverBorder": "#4f5258",

    // The title bar is reduced to a quiet strip (a terminal has none).
    "titleBar.background": "#07080d",
    "titleBar.foreground": "#9b9ea4",
    "titleBar.inactiveForeground": "#4f5258",
    "titleBar.border": "#07080d",
    "titleBar.logo": "#b3f6c0",
    "titleIcon.activeForeground": "#e0e2ea",
    "windowControl.foreground": "#9b9ea4",
    "windowControl.hoverBackground": "#2c2e33",
    "windowControl.closeHoverBackground": "#590008",
    "windowControl.closeHoverForeground": "#ffc0b9",
    "menu.background": "#07080d",
    "menu.foreground": "#e0e2ea",
    "menu.selectionBackground": "#2c2e33",
    "menu.border": "#4f5258",

    // File tree (nvim-tree): same background as buffers, WinSeparator line.
    "sideBar.background": "#14161b",
    "sideBar.foreground": "#e0e2ea",
    "sideBar.border": "#2c2e33",
    "sideBarTitle.foreground": "#9b9ea4",
    "sideBarSectionHeader.foreground": "#8cf8f7",
    "list.hoverBackground": "#2c2e33",
    "list.activeSelectionBackground": "#2c2e33",
    "list.activeSelectionForeground": "#eef1f8",
    "icon.folder": "#8cf8f7",
    "icon.file": "#c4c6cd",
    "icon.csharp": "#b3f6c0",
    "icon.project": "#fce094",
    "icon.json": "#fce094",
    "icon.markup": "#ffc0b9",
    "icon.markdown": "#a6dbff",

    // Buffer tabs (TabLine / TabLineSel / TabLineFill).
    "editorGroupHeader.background": "#07080d",
    "editorGroupHeader.border": "#07080d",
    "tab.activeBackground": "#14161b",
    "tab.activeForeground": "#eef1f8",
    "tab.activeBorder": "#14161b",
    "tab.activeBorderTop": "#a6dbff",
    "tab.inactiveBackground": "#07080d",
    "tab.inactiveForeground": "#9b9ea4",
    "tab.hoverBackground": "#2c2e33",
    "tab.border": "#07080d",
    "tab.modifiedIndicator": "#fce094",

    // Buffers.
    "editor.background": "#14161b",
    "editor.foreground": "#e0e2ea",
    "editor.lineHighlightBackground": "#2c2e33",
    "editor.selectionBackground": "#4f5258",
    "editor.inactiveSelectionBackground": "#2c2e33",
    "editor.findMatchBackground": "#6b5300",
    "editor.findMatchBorder": "#6b5300",
    "editorCursor.foreground": "#e0e2ea",
    "editorCursor.background": "#14161b",
    "editorLineNumber.foreground": "#4f5258",
    "editorLineNumber.activeForeground": "#e0e2ea",
    "editorGutter.background": "#14161b",
    "editorIndentGuide.background": "#2c2e33",
    "editorWhitespace.foreground": "#4f5258",
    "editorRuler.foreground": "#2c2e33",
    "editorBracketMatch.background": "#4f5258",
    "editorBracketMatch.border": "#4f5258",
    "editorError.foreground": "#ffc0b9",
    "editorWarning.foreground": "#fce094",
    "editorInfo.foreground": "#8cf8f7",
    // Floating windows (hover, completion = Pmenu).
    "editorWidget.background": "#07080d",
    "editorWidget.border": "#4f5258",
    "editorHoverWidget.background": "#07080d",
    "editorHoverWidget.foreground": "#e0e2ea",
    "editorHoverWidget.border": "#4f5258",

    // Signs and diffs (Added / Changed / Removed, DiffAdd / DiffDelete).
    "editorGutter.addedBackground": "#b3f6c0",
    "editorGutter.modifiedBackground": "#8cf8f7",
    "editorGutter.deletedBackground": "#ffc0b9",
    "diffEditor.insertedLineBackground": "#005523",
    "diffEditor.removedLineBackground": "#590008",
    "diffEditor.hunkHeaderBackground": "#004c73",
    "gitDecoration.addedResourceForeground": "#b3f6c0",
    "gitDecoration.modifiedResourceForeground": "#8cf8f7",
    "gitDecoration.stageModifiedResourceForeground": "#8cf8f7",
    "gitDecoration.deletedResourceForeground": "#ffc0b9",
    "gitDecoration.renamedResourceForeground": "#b3f6c0",
    "gitDecoration.untrackedResourceForeground": "#fce094",
    "gitDecoration.conflictingResourceForeground": "#ffcaff",
    "activityBarBadge.background": "#a6dbff",
    "activityBarBadge.foreground": "#07080d",
    "badge.background": "#2c2e33",
    "badge.foreground": "#e0e2ea",
    "errorForeground": "#ffc0b9",

    // Panel (quickfix / messages).
    "panel.background": "#14161b",
    "panel.border": "#2c2e33",
    "panelTitle.activeForeground": "#eef1f8",
    "panelTitle.inactiveForeground": "#9b9ea4",
    "panelTitle.activeBorder": "#a6dbff",
    "panelTitle.activeBackground": "transparent",
    "problemsErrorIcon.foreground": "#ffc0b9",
    "problemsWarningIcon.foreground": "#fce094",
    "problemsInfoIcon.foreground": "#8cf8f7",

    // Status line (lualine): grey middle, colored blocks at the ends.
    "statusBar.background": "#2c2e33",
    "statusBar.foreground": "#c4c6cd",
    "statusBar.border": "#2c2e33",
    "statusBarItem.hoverBackground": "#4f5258",
    "statusBarItem.text:NORMAL.background": "#a6dbff",
    "statusBarItem.text:NORMAL.foreground": "#07080d",
    "statusBarItem.branch.background": "#4f5258",
    "statusBarItem.branch.foreground": "#eef1f8",
    "statusBarItem.file.foreground": "#eef1f8",
    "statusBarItem.language.background": "#4f5258",
    "statusBarItem.language.foreground": "#eef1f8",
    "statusBarItem.position.background": "#a6dbff",
    "statusBarItem.position.foreground": "#07080d",

    // Command line / pickers (Telescope-like).
    "input.background": "#07080d",
    "input.foreground": "#e0e2ea",
    "input.border": "#4f5258",
    "input.placeholderForeground": "#4f5258",
    "button.background": "#2c2e33",
    "button.foreground": "#e0e2ea",
    "button.hoverBackground": "#4f5258",
    "button.secondaryBackground": "#2c2e33",
    "button.border": "#4f5258",
    "scrollbarSlider.background": "#2c2e33",
    "scrollbarSlider.hoverBackground": "#4f5258",
    "scrollbarSlider.activeBackground": "#4f5258",
    "quickInput.background": "#07080d",
    "quickInput.foreground": "#e0e2ea",
    "quickInput.border": "#4f5258",

    // The intro screen.
    "welcome.logo": "#2c2e33",
    "welcome.titleForeground": "#e0e2ea",
    "welcome.foreground": "#9b9ea4"
  },

  // Neovim's default syntax groups: mostly grey with bold statements, green strings, cyan functions,
  // blue identifiers/properties, grey comments.
  "tokenColors": {
    "keyword": { "foreground": "#e0e2ea", "fontStyle": "bold" },
    "keyword - control": { "foreground": "#e0e2ea", "fontStyle": "bold" },
    "preprocessor keyword": "#e0e2ea",
    "preprocessor text": "#9b9ea4",
    "comment": "#9b9ea4",
    "xml doc comment": "#9b9ea4",
    "xml doc comment - name": "#9b9ea4",
    "xml doc comment - attribute name": "#9b9ea4",
    "excluded code": "#4f5258",
    "string": "#b3f6c0",
    "string - verbatim": "#b3f6c0",
    "string - escape character": "#8cf8f7",
    "number": "#e0e2ea",
    "operator": "#e0e2ea",
    "operator - overloaded": "#8cf8f7",
    "punctuation": "#e0e2ea",
    "identifier": "#e0e2ea",
    "namespace name": "#e0e2ea",
    "class name": "#e0e2ea",
    "record class name": "#e0e2ea",
    "struct name": "#e0e2ea",
    "record struct name": "#e0e2ea",
    "interface name": "#e0e2ea",
    "enum name": "#e0e2ea",
    "delegate name": "#e0e2ea",
    "type parameter name": "#e0e2ea",
    "module name": "#e0e2ea",
    "method name": "#8cf8f7",
    "extension method name": "#8cf8f7",
    "property name": "#a6dbff",
    "field name": "#a6dbff",
    "event name": "#a6dbff",
    "local name": "#e0e2ea",
    "parameter name": "#e0e2ea",
    "label name": "#e0e2ea",
    "constant name": "#e0e2ea",
    "enum member name": "#e0e2ea",
    "regex - character class": "#8cf8f7",
    "regex - anchor": "#8cf8f7",
    "regex - quantifier": "#8cf8f7",
    "json - property name": "#a6dbff",
    "json - string": "#b3f6c0"
  },

  "fonts": {
    // Monospace everywhere, like a terminal grid.
    "ui.family": "JetBrains Mono, Cascadia Mono, Cascadia Code, Fira Code, Hack, DejaVu Sans Mono, Noto Sans Mono, Consolas, monospace",
    "ui.size": 13,
    "ui.smallSize": 12,
    "menuBar.fontSize": 12,
    "tab.fontSize": 13,
    "tab.activeWeight": "bold",
    "sideBarTitle.fontSize": 13,
    "sideBarSectionHeader.fontSize": 13,
    "sideBarSectionHeader.weight": "bold",
    "panelTab.fontSize": 12,
    "list.fontSize": 13,
    "statusBar.fontSize": 13,
    "statusBarItem.text:NORMAL.weight": "bold",
    "statusBarItem.position.weight": "bold",
    "welcome.titleSize": 32,
    "welcome.titleWeight": "bold",
    "editor.family": "JetBrains Mono, Cascadia Mono, Cascadia Code, Fira Code, Hack, DejaVu Sans Mono, Noto Sans Mono, Consolas, monospace",
    "editor.size": 14,
    "editor.lineHeight": 1.35,
    "editor.lineNumberSize": 14
  },

  "metrics": {
    "titleBar.height": 26,
    "titleBar.borderThickness": 0,
    "titleBar.iconSize": 13,
    "titleBar.logoSize": 13,
    "titleIcon.radius": 0,
    "menuBarItem.radius": 0,
    "windowControl.width": 40,
    "windowControl.iconSize": 12,
    "sideBar.width": 260,
    "list.itemHeight": 20,
    "list.radius": 0,
    "explorer.iconSize": 13,
    "explorer.itemSpacing": 6,
    "tab.height": 24,
    "tab.padding": "10,0,6,0",
    "tab.radius": 0,
    "tab.borderThickness": 0,
    "tab.minWidth": 0,
    "tab.indicatorSize": 2,
    "tab.indicatorRadius": 0,
    "tab.closeRadius": 0,
    "editorGroupHeader.borderThickness": 0,
    "panel.height": 200,
    "panel.borderThickness": 1,
    "panelHeader.height": 24,
    "panelTab.radius": 0,
    "statusBar.height": 22,
    "statusBar.borderThickness": 0,
    "statusBar.iconSize": 12,
    "statusBarItem.padding": 10,
    "statusBarItem.radius": 0,
    "widget.radius": 0,
    "palette.radius": 0,
    "findWidget.radius": 0,
    "input.radius": 0,
    "button.radius": 0,
    "scrollbar.radius": 0,
    "editorGutter.changeWidth": 2,
    "editorGutter.changeOffset": 1,
    "welcome.logoSize": 72,
    "welcome.spacing": 4
  },

  "editor": {
    "cursorStyle": "block",
    "cursorBlinking": "solid",
    "smoothCaretAnimation": false,
    "lineHighlight": "none",
    "selectionRadius": 0,
    "renderWhitespace": "none",
    "squiggleStyle": "wavy",
    "bracketPairColorization": false,
    "matchBrackets": true,
    "indentGuides": false,
    "rulers": "",
    "textPadding": 6,
    "gutterPaddingLeft": 6,
    "gutterPaddingRight": 10
  },

  "effects": {
    "window.backdrop": "none",
    "palette.shadow": "none",
    "widget.shadow": "none"
  },

  "layout": {
    // No activity bar and no side bar header: just a tree, buffers and the status line.
    "main.order": ["sideBar", "editor"],
    "sideBar.order": ["content"],
    "editor.order": ["tabs", "content", "panel"],
    "tab.indicatorPosition": "top",

    "titleBar.left": ["title"],
    "titleBar.center": [],
    "titleBar.right": ["windowControls"],

    "statusBar.left": ["text:NORMAL", "branch", "file", "problems"],
    "statusBar.center": [],
    "statusBar.right": ["modules", "lsp", "encoding", "eol", "language", "position"],
    "statusBar.positionFormat": "{line}:{col}",

    "welcome.order": ["title", "shortcuts"],
    "welcome.title": "NVIM — ByteForge",
    "welcome.shortcuts": ["view.quickOpen", "view.search", "file.openFolder", "view.scm", "theme.select", "view.commandPalette"]
  }
}
