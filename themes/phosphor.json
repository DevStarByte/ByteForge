{
  // Retro green CRT: monospace UI, block cursor, square corners, inverted status bar, custom logo.
  "name": "Phosphor",
  "type": "dark",
  "inherits": "ByteForge Dark",
  "description": "Retro green-screen terminal",

  "colors": {
    "accent": "#33ff66",
    "focusBorder": "#33ff66",
    "window.background": "#050a05",
    "window.foreground": "#33ff66",
    "foreground.muted": "#1f9e40",
    "icon.foreground": "#33ff66",
    "overlay.background": "#00000080",
    "toolbar.hoverBackground": "#33ff6626",
    "sash.hoverBorder": "#33ff66",

    "titleBar.background": "#050a05",
    "titleBar.foreground": "#33ff66",
    "titleBar.inactiveForeground": "#1f9e40",
    "titleBar.border": "#1f9e40",
    "titleBar.logo": "#33ff66",
    "titleIcon.activeForeground": "#a6ffbf",
    "commandCenter.background": "#050a05",
    "commandCenter.foreground": "#33ff66",
    "commandCenter.activeForeground": "#a6ffbf",
    "commandCenter.border": "#1f9e40",
    "commandCenter.hoverBorder": "#33ff66",
    "commandCenter.hoverBackground": "#0c1a0c",
    "windowControl.foreground": "#33ff66",
    "windowControl.hoverBackground": "#33ff6626",
    "windowControl.closeHoverBackground": "#33ff66",
    "windowControl.closeHoverForeground": "#050a05",
    "menu.background": "#050a05",
    "menu.foreground": "#33ff66",
    "menu.selectionBackground": "#33ff6640",
    "menu.border": "#1f9e40",

    "activityBar.background": "#050a05",
    "activityBar.foreground": "#33ff66",
    "activityBar.inactiveForeground": "#1f9e40",
    "activityBar.activeBorder": "#33ff66",
    "activityBar.border": "#1f9e40",

    "sideBar.background": "#050a05",
    "sideBar.foreground": "#33ff66",
    "sideBar.border": "#1f9e40",
    "sideBarTitle.foreground": "#a6ffbf",
    "sideBarSectionHeader.foreground": "#a6ffbf",
    "list.hoverBackground": "#33ff661a",
    "list.activeSelectionBackground": "#33ff66",
    "list.activeSelectionForeground": "#050a05",
    "icon.folder": "#33ff66",
    "icon.file": "#1f9e40",
    "icon.csharp": "#a6ffbf",
    "icon.project": "#a6ffbf",
    "icon.json": "#ffcc33",
    "icon.markup": "#ffcc33",
    "icon.markdown": "#a6ffbf",

    "editorGroupHeader.background": "#050a05",
    "editorGroupHeader.border": "#1f9e40",
    "tab.activeBackground": "#0c1a0c",
    "tab.activeForeground": "#a6ffbf",
    "tab.activeBorder": "#1f9e40",
    "tab.inactiveBackground": "#050a05",
    "tab.inactiveForeground": "#1f9e40",
    "tab.hoverBackground": "#0c1a0c",
    "tab.border": "#1f9e40",
    "tab.activeBorderTop": "#33ff66",
    "tab.modifiedIndicator": "#ffcc33",
    "breadcrumb.background": "#050a05",
    "breadcrumb.foreground": "#1f9e40",
    "breadcrumb.activeForeground": "#33ff66",
    "breadcrumb.border": "#1f9e40",

    "editor.background": "#050a05",
    "editor.foreground": "#33ff66",
    "editor.lineHighlightBackground": "#33ff660f",
    "editor.lineHighlightBorder": "transparent",
    "editor.selectionBackground": "#33ff6648",
    "editor.inactiveSelectionBackground": "#33ff6626",
    "editor.findMatchBackground": "#ffcc3340",
    "editor.findMatchBorder": "#ffcc33",
    "editorCursor.foreground": "#33ff66",
    "editorCursor.background": "#050a05",
    "editorLineNumber.foreground": "#145c26",
    "editorLineNumber.activeForeground": "#33ff66",
    "editorGutter.background": "#050a05",
    "editorGutter.border": "#1f9e40",
    "editorIndentGuide.background": "#0f2e17",
    "editorWhitespace.foreground": "#145c26",
    "editorBracketMatch.background": "#33ff6626",
    "editorBracketMatch.border": "#33ff66",
    "editorBracketHighlight.foreground1": "#a6ffbf",
    "editorBracketHighlight.foreground2": "#ffcc33",
    "editorBracketHighlight.foreground3": "#33ff66",
    "editorError.foreground": "#ff5555",
    "editorWarning.foreground": "#ffcc33",
    "editorInfo.foreground": "#a6ffbf",
    "editorWidget.background": "#050a05",
    "editorWidget.border": "#33ff66",
    "editorHoverWidget.background": "#050a05",
    "editorHoverWidget.foreground": "#33ff66",
    "editorHoverWidget.border": "#33ff66",

    "panel.background": "#050a05",
    "panel.border": "#1f9e40",
    "panelTitle.activeForeground": "#a6ffbf",
    "panelTitle.inactiveForeground": "#1f9e40",
    "panelTitle.activeBorder": "#33ff66",
    "problemsErrorIcon.foreground": "#ff5555",
    "problemsWarningIcon.foreground": "#ffcc33",
    "problemsInfoIcon.foreground": "#a6ffbf",

    "statusBar.background": "#33ff66",
    "statusBar.foreground": "#050a05",
    "statusBar.border": "#33ff66",
    "statusBarItem.hoverBackground": "#050a0530",

    "input.background": "#050a05",
    "input.foreground": "#33ff66",
    "input.border": "#1f9e40",
    "input.placeholderForeground": "#1f9e40",
    "button.background": "#33ff66",
    "button.foreground": "#050a05",
    "button.hoverBackground": "#a6ffbf",
    "button.secondaryBackground": "#0c1a0c",
    "button.border": "#33ff66",
    "scrollbarSlider.background": "#33ff6633",
    "scrollbarSlider.hoverBackground": "#33ff6666",
    "scrollbarSlider.activeBackground": "#33ff66aa",
    "quickInput.background": "#050a05",
    "quickInput.foreground": "#33ff66",
    "quickInput.border": "#33ff66",
    "welcome.logo": "#33ff6630",
    "welcome.titleForeground": "#33ff66",
    "welcome.foreground": "#1f9e40"
  },

  "tokenColors": {
    "keyword": { "foreground": "#a6ffbf", "fontStyle": "bold" },
    "keyword - control": { "foreground": "#a6ffbf", "fontStyle": "bold" },
    "comment": "#1f9e40",
    "xml doc comment": "#1f9e40",
    "string": "#ffcc33",
    "number": "#ffcc33",
    "class name": { "foreground": "#33ff66", "fontStyle": "underline" },
    "method name": "#a6ffbf",
    "identifier": "#33ff66",
    "punctuation": "#1f9e40",
    "operator": "#a6ffbf"
  },

  "fonts": {
    "ui.family": "JetBrains Mono, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace",
    "ui.size": 12,
    "tab.fontSize": 12,
    "list.fontSize": 12,
    "welcome.titleWeight": "bold"
  },

  "metrics": {
    "commandCenter.radius": 0,
    "menuBarItem.radius": 0,
    "titleIcon.radius": 0,
    "widget.radius": 0,
    "palette.radius": 0,
    "findWidget.radius": 0,
    "input.radius": 0,
    "button.radius": 0,
    "tab.closeRadius": 0,
    "tab.indicatorSize": 2,
    "scrollbar.size": 12,
    "editorWidget.borderThickness": 1
  },

  "editor": {
    "cursorStyle": "block",
    "cursorBlinking": "blink",
    "smoothCaretAnimation": false,
    "selectionRadius": 0,
    "squiggleStyle": "dotted",
    "lineHighlight": "gutter"
  },

  "effects": {
    "palette.shadow": "0 0 24 0 #33ff6640",
    "widget.shadow": "0 0 12 0 #33ff6630"
  },

  // A terminal prompt as the logo.
  "icons": {
    "logo": "M3,4H21V20H3V4M5,6V18H19V6H5M7,8.5L10.5,12L7,15.5L8.4,16.9L13.3,12L8.4,7.1L7,8.5M12,15H17V17H12V15Z"
  }
}
