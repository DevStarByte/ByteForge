{
  // Synthwave: gradient bars, neon glow shadows, rounded tabs, phase-blinking caret.
  "name": "Neon Grid",
  "type": "dark",
  "inherits": "ByteForge Dark",
  "description": "Synthwave neon with gradients and glow",

  "colors": {
    "accent": "#ff2a6d",
    "focusBorder": "#b967ff",
    "window.background": "#1a1029",
    "window.foreground": "#e8dcff",
    "foreground.muted": "#9a86c4",
    "icon.foreground": "#e8dcff",
    "sash.hoverBorder": "#05d9e8",

    "titleBar.background": "linear-gradient(90deg, #2d1650, #1a1029 45%, #102a3f)",
    "titleBar.foreground": "#f3e8ff",
    "titleBar.border": "#ff2a6d55",
    "titleBar.logo": "linear-gradient(135deg, #ff2a6d, #05d9e8)",
    "titleIcon.activeForeground": "#05d9e8",
    "commandCenter.background": "#24123d",
    "commandCenter.foreground": "#c9b6f2",
    "commandCenter.activeForeground": "#ffffff",
    "commandCenter.border": "#b967ff66",
    "commandCenter.hoverBorder": "#05d9e8",
    "commandCenter.hoverBackground": "#2d1650",
    "windowControl.hoverBackground": "#b967ff33",
    "windowControl.closeHoverBackground": "#ff2a6d",
    "menu.background": "#1f1433",
    "menu.selectionBackground": "#ff2a6d66",
    "menu.border": "#b967ff55",

    "activityBar.background": "#140c22",
    "activityBar.foreground": "#05d9e8",
    "activityBar.inactiveForeground": "#7e6aa8",
    "activityBar.activeBorder": "linear-gradient(180deg, #ff2a6d, #05d9e8)",
    "activityBar.activeBackground": "#05d9e812",
    "activityBar.border": "#ff2a6d33",

    "sideBar.background": "#1a1029",
    "sideBar.foreground": "#d9caff",
    "sideBar.border": "#ff2a6d33",
    "sideBarTitle.foreground": "#ff7edb",
    "sideBarSectionHeader.foreground": "#05d9e8",
    "list.hoverBackground": "#b967ff1f",
    "list.activeSelectionBackground": "linear-gradient(90deg, #ff2a6d55, #b967ff22)",
    "list.activeSelectionForeground": "#ffffff",
    "icon.folder": "#ff7edb",
    "icon.csharp": "#05d9e8",
    "icon.project": "#b967ff",

    "editorGroupHeader.background": "#140c22",
    "editorGroupHeader.border": "#ff2a6d33",
    "tab.activeBackground": "#241b2f",
    "tab.activeForeground": "#ffffff",
    "tab.activeBorder": "#b967ff55",
    "tab.inactiveBackground": "#1a1029",
    "tab.inactiveForeground": "#9a86c4",
    "tab.hoverBackground": "#2d1650",
    "tab.border": "transparent",
    "tab.activeBorderTop": "linear-gradient(90deg, #ff2a6d, #b967ff, #05d9e8)",
    "tab.modifiedIndicator": "#ff2a6d",
    "breadcrumb.background": "#241b2f",
    "breadcrumb.foreground": "#9a86c4",
    "breadcrumb.activeForeground": "#05d9e8",

    "editor.background": "#241b2f",
    "editor.foreground": "#f8f8f2",
    "editor.lineHighlightBackground": "#ffffff06",
    "editor.lineHighlightBorder": "#ff2a6d40",
    "editor.selectionBackground": "#ff2a6d3a",
    "editor.inactiveSelectionBackground": "#b967ff26",
    "editor.findMatchBackground": "#05d9e830",
    "editor.findMatchBorder": "#05d9e8",
    "editorCursor.foreground": "#05d9e8",
    "editorLineNumber.foreground": "#5d4a85",
    "editorLineNumber.activeForeground": "#ff7edb",
    "editorGutter.background": "#241b2f",
    "editorIndentGuide.background": "#3b2d55",
    "editorBracketMatch.background": "#05d9e822",
    "editorBracketMatch.border": "#05d9e8",
    "editorBracketHighlight.foreground1": "#ff7edb",
    "editorBracketHighlight.foreground2": "#05d9e8",
    "editorBracketHighlight.foreground3": "#fede5d",
    "editorBracketHighlight.foreground4": "#72f1b8",
    "editorWidget.background": "#1f1433",
    "editorWidget.border": "#b967ff66",
    "editorHoverWidget.background": "#1f1433",
    "editorHoverWidget.border": "#ff2a6d88",

    "panel.background": "#1a1029",
    "panel.border": "#ff2a6d33",
    "panelTitle.activeForeground": "#05d9e8",
    "panelTitle.activeBorder": "#05d9e8",

    "statusBar.background": "linear-gradient(90deg, #ff2a6d, #b967ff 55%, #05d9e8)",
    "statusBar.foreground": "#140c22",
    "statusBar.border": "transparent",
    "statusBarItem.hoverBackground": "#ffffff40",

    "input.background": "#24123d",
    "input.border": "#b967ff55",
    "button.background": "linear-gradient(90deg, #ff2a6d, #b967ff)",
    "button.hoverBackground": "linear-gradient(90deg, #ff4d88, #c98bff)",
    "scrollbarSlider.background": "#b967ff44",
    "scrollbarSlider.hoverBackground": "#b967ff88",
    "scrollbarSlider.activeBackground": "#05d9e888",
    "quickInput.background": "#1f1433",
    "quickInput.border": "#ff2a6d88",
    "welcome.logo": "linear-gradient(135deg, #ff2a6d44, #05d9e844)",
    "welcome.titleForeground": "#ff7edb",
    "welcome.foreground": "#9a86c4"
  },

  "tokenColors": {
    "keyword": { "foreground": "#fede5d", "fontStyle": "bold" },
    "keyword - control": "#ff7edb",
    "comment": { "foreground": "#848bbd", "fontStyle": "italic" },
    "string": "#ff8b39",
    "string - escape character": "#fede5d",
    "number": "#f97e72",
    "class name": "#fe4450",
    "record class name": "#fe4450",
    "interface name": "#72f1b8",
    "struct name": "#72f1b8",
    "enum name": "#72f1b8",
    "method name": "#36f9f6",
    "extension method name": "#36f9f6",
    "property name": "#ff7edb",
    "field name": "#ff7edb",
    "local name": "#ffffff",
    "parameter name": "#f3e8ff",
    "namespace name": "#b6b1b1",
    "constant name": "#f97e72",
    "enum member name": "#f97e72",
    "operator": "#fede5d",
    "punctuation": "#b6b1b1"
  },

  "metrics": {
    "titleBar.borderThickness": "0,0,0,1",
    "commandCenter.radius": 12,
    "tab.margin": "2,5,0,0",
    "tab.radius": "8,8,0,0",
    "tab.borderThickness": 0,
    "tab.indicatorSize": 2,
    "tab.indicatorRadius": 2,
    "widget.radius": 10,
    "palette.radius": 14,
    "list.radius": 6,
    "list.itemMargin": "6,1",
    "button.radius": 8,
    "input.radius": 8,
    "scrollbar.size": 10,
    "scrollbar.radius": 5,
    "scrollbar.thumbMargin": 2,
    "activityBar.indicatorLeft.border": "3,0,0,0"
  },

  "editor": {
    "cursorBlinking": "phase",
    "cursorWidth": 3,
    "lineHighlight": "border",
    "selectionRadius": 4
  },

  "effects": {
    "palette.shadow": "0 0 36 2 #ff2a6d55, 0 10 30 0 #00000099",
    "widget.shadow": "0 0 20 0 #b967ff55"
  }
}
