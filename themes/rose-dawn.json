{
  // Warm pastel light theme: pill tabs, side bar on the right, underline cursor, gutter line highlight.
  "name": "Rosé Dawn",
  "type": "light",
  "inherits": "ByteForge Light",
  "description": "Soft warm pastel light",

  "colors": {
    "accent": "#d7827e",
    "focusBorder": "#d7827e",
    "window.background": "#faf4ed",
    "window.foreground": "#575279",
    "foreground.muted": "#9893a5",
    "icon.foreground": "#575279",
    "sash.hoverBorder": "#d7827e",

    "titleBar.background": "#f2e9e1",
    "titleBar.foreground": "#575279",
    "titleBar.border": "#e4dfde",
    "titleBar.logo": "#b4637a",
    "commandCenter.background": "#fffaf3",
    "commandCenter.border": "#dfdad9",
    "commandCenter.hoverBorder": "#d7827e",
    "commandCenter.hoverBackground": "#fffaf3",
    "menu.background": "#fffaf3",
    "menu.selectionBackground": "#d7827e33",

    "activityBar.background": "#f2e9e1",
    "activityBar.foreground": "#575279",
    "activityBar.inactiveForeground": "#9893a5",
    "activityBar.activeBorder": "#d7827e",
    "activityBar.activeBackground": "#d7827e1f",
    "activityBar.border": "#e4dfde",

    "sideBar.background": "#fffaf3",
    "sideBar.foreground": "#575279",
    "sideBar.border": "#e4dfde",
    "sideBarTitle.foreground": "#797593",
    "sideBarSectionHeader.foreground": "#b4637a",
    "list.hoverBackground": "#f2e9e1",
    "list.activeSelectionBackground": "#d7827e2e",
    "list.activeSelectionForeground": "#575279",
    "icon.folder": "#ea9d34",
    "icon.csharp": "#907aa9",
    "icon.project": "#286983",
    "icon.json": "#ea9d34",
    "icon.markup": "#d7827e",
    "icon.markdown": "#56949f",

    "editorGroupHeader.background": "#faf4ed",
    "editorGroupHeader.border": "transparent",
    "tab.activeBackground": "#fffaf3",
    "tab.activeForeground": "#575279",
    "tab.activeBorder": "#dfdad9",
    "tab.inactiveBackground": "transparent",
    "tab.inactiveForeground": "#9893a5",
    "tab.hoverBackground": "#f2e9e1",
    "tab.border": "transparent",
    "tab.activeBorderTop": "transparent",
    "tab.modifiedIndicator": "#b4637a",
    "breadcrumb.background": "#fffaf3",
    "breadcrumb.foreground": "#9893a5",
    "breadcrumb.activeForeground": "#575279",

    "editor.background": "#fffaf3",
    "editor.foreground": "#575279",
    "editor.lineHighlightBackground": "#f2e9e1",
    "editor.selectionBackground": "#dfdad9",
    "editor.inactiveSelectionBackground": "#f2e9e1",
    "editor.findMatchBackground": "#ea9d3440",
    "editorCursor.foreground": "#b4637a",
    "editorLineNumber.foreground": "#c9c3cf",
    "editorLineNumber.activeForeground": "#575279",
    "editorGutter.background": "#fffaf3",
    "editorIndentGuide.background": "#ebe5e0",
    "editorBracketHighlight.foreground1": "#907aa9",
    "editorBracketHighlight.foreground2": "#56949f",
    "editorBracketHighlight.foreground3": "#ea9d34",
    "editorError.foreground": "#b4637a",
    "editorWarning.foreground": "#ea9d34",
    "editorInfo.foreground": "#56949f",
    "editorWidget.background": "#fffaf3",
    "editorWidget.border": "#dfdad9",

    "panel.background": "#faf4ed",
    "panel.border": "#e4dfde",
    "panelTitle.activeBorder": "#d7827e",
    "panelTitle.activeBackground": "#d7827e1a",

    "statusBar.background": "#f2e9e1",
    "statusBar.foreground": "#797593",
    "statusBar.border": "#e4dfde",
    "statusBarItem.hoverBackground": "#d7827e26",

    "input.background": "#fffaf3",
    "input.border": "#dfdad9",
    "button.background": "#d7827e",
    "button.hoverBackground": "#c56f6b",
    "quickInput.background": "#fffaf3",
    "quickInput.border": "#dfdad9",
    "scrollbarSlider.background": "#9893a540",
    "scrollbarSlider.hoverBackground": "#9893a570",
    "welcome.logo": "#d7827e30",
    "welcome.titleForeground": "#c9c3cf"
  },

  "tokenColors": {
    "keyword": "#286983",
    "keyword - control": "#286983",
    "comment": { "foreground": "#9893a5", "fontStyle": "italic" },
    "string": "#ea9d34",
    "number": "#d7827e",
    "class name": "#56949f",
    "record class name": "#56949f",
    "struct name": "#56949f",
    "interface name": "#56949f",
    "enum name": "#56949f",
    "method name": "#d7827e",
    "extension method name": "#d7827e",
    "property name": "#907aa9",
    "field name": "#907aa9",
    "local name": "#575279",
    "parameter name": "#907aa9",
    "constant name": "#b4637a",
    "enum member name": "#b4637a",
    "operator": "#797593",
    "punctuation": "#797593",
    "namespace name": "#575279"
  },

  "metrics": {
    "tabStrip.padding": "6,0",
    "tab.spacing": 2,
    "tab.margin": "0,5",
    "tab.radius": 999,
    "tab.padding": "14,0,8,0",
    "tab.borderThickness": 1,
    "tab.indicatorSize": 0,
    "editorGroupHeader.borderThickness": 0,
    "activityBar.itemRadius": 10,
    "activityBar.itemHeight": 44,
    "activityBar.spacing": 4,
    "activityBar.indicatorLeft.border": 0,
    "activityBar.indicatorRight.border": 0,
    "list.radius": 6,
    "list.itemMargin": "6,1",
    "panelTab.radius": 999,
    "panelTab.padding": "12,4",
    "panelTab.indicator.border": 0,
    "commandCenter.radius": 999,
    "widget.radius": 12,
    "palette.radius": 16,
    "button.radius": 999,
    "input.radius": 8,
    "scrollbar.size": 10,
    "scrollbar.radius": 5,
    "scrollbar.thumbMargin": 2
  },

  "editor": {
    "cursorStyle": "underline",
    "cursorWidth": 2,
    "lineHighlight": "all",
    "selectionRadius": 6
  },

  "effects": {
    "palette.shadow": "0 12 36 0 #57527930",
    "widget.shadow": "0 6 18 0 #57527925"
  },

  "layout": {
    "sideBar.position": "right"
  }
}
