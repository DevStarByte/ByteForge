{
  // Deep-sea dark theme: near-black navy that gets darker towards the edges, bioluminescent cyan for focus and
  // a jellyfish magenta for what needs attention. Gradients run top-down like light fading in water, widgets
  // glow faintly, and the caret glides. The line highlight sits in the gutter only, so the code floats.
  "name": "Abyss",
  "type": "dark",
  "inherits": "ByteForge Dark",
  "description": "Deep ocean navy with bioluminescent glow",

  "colors": {
    "accent": "#3ee6d0",
    "focusBorder": "#3ee6d0",
    "window.background": "#050b14",
    "window.foreground": "#c6d8e8",
    "foreground.muted": "#5f7a91",
    "icon.foreground": "#9fb8cc",
    "overlay.background": "#02060c99",
    "toolbar.hoverBackground": "#0f2033",
    "sash.hoverBorder": "#3ee6d0",

    "titleBar.background": "linear-gradient(180deg, #0c1c2e, #050b14)",
    "titleBar.foreground": "#c6d8e8",
    "titleBar.inactiveForeground": "#5f7a91",
    "titleBar.border": "#0c1a29",
    "titleBar.logo": "linear-gradient(135deg, #3ee6d0, #2a7fff)",
    "commandCenter.background": "#0a1624",
    "commandCenter.foreground": "#7f9ab0",
    "commandCenter.border": "#14283d",
    "commandCenter.hoverBorder": "#3ee6d060",
    "commandCenter.hoverBackground": "#0f2033",
    "windowControl.hoverBackground": "#0f2033",
    "windowControl.closeHoverBackground": "#e0459b",
    "menu.background": "#08121f",
    "menu.foreground": "#c6d8e8",
    "menu.selectionBackground": "#12304a",
    "menu.border": "#14283d",

    "activityBar.background": "#040912",
    "activityBar.foreground": "#3ee6d0",
    "activityBar.inactiveForeground": "#3f566b",
    "activityBar.activeBorder": "linear-gradient(180deg, #3ee6d0, #2a7fff)",
    "activityBar.activeBackground": "#3ee6d010",
    "activityBar.hoverBackground": "#0a1624",
    "activityBar.border": "transparent",
    "activityBarBadge.background": "#e0459b",
    "activityBarBadge.foreground": "#ffffff",
    "badge.background": "#3ee6d0",
    "badge.foreground": "#03141a",

    "sideBar.background": "#060e19",
    "sideBar.foreground": "#b2c6d8",
    "sideBar.border": "#0c1a29",
    "sideBarTitle.foreground": "#5f7a91",
    "sideBarSectionHeader.foreground": "#3ee6d0",
    "list.hoverBackground": "#0c1b2c",
    "list.activeSelectionBackground": "#12304a",
    "list.activeSelectionForeground": "#e6f4ff",
    "list.activeFileBackground": "#0f2740",
    "list.activeFileForeground": "#e6f4ff",
    "list.activeFileIndicator": "#3ee6d0",
    "icon.folder": "#2a7fff",
    "icon.csharp": "#a78bfa",
    "icon.project": "#3ee6d0",
    "icon.json": "#f5c86b",
    "icon.markdown": "#5fd0ff",

    "editorGroupHeader.background": "#060e19",
    "editorGroupHeader.border": "#0c1a29",
    "tab.activeBackground": "#08121f",
    "tab.activeForeground": "#e6f4ff",
    "tab.inactiveBackground": "#060e19",
    "tab.inactiveForeground": "#4f687e",
    "tab.hoverBackground": "#0a1624",
    "tab.border": "transparent",
    "tab.activeBorderTop": "linear-gradient(90deg, #3ee6d0, #2a7fff)",
    "tab.modifiedIndicator": "#e0459b",
    "breadcrumb.background": "#08121f",
    "breadcrumb.foreground": "#4f687e",
    "breadcrumb.activeForeground": "#c6d8e8",

    "editor.background": "#08121f",
    "editor.foreground": "#c6d8e8",
    "editorGutter.background": "#08121f",
    "editor.lineHighlightBackground": "#3ee6d00c",
    "editor.lineHighlightBorder": "transparent",
    "editor.selectionBackground": "#2a7fff40",
    "editor.inactiveSelectionBackground": "#2a7fff22",
    "editor.findMatchBackground": "#e0459b40",
    "editor.findMatchBorder": "#e0459b",
    "editor.wordHighlightBackground": "#3ee6d018",
    "editor.wordHighlightStrongBackground": "#3ee6d028",
    "editorInlayHint.foreground": "#4f687e",
    "editorInlayHint.background": "#0c1a29",
    "editorCursor.foreground": "#3ee6d0",
    "editorLineNumber.foreground": "#253b50",
    "editorLineNumber.activeForeground": "#3ee6d0",
    "editorIndentGuide.background": "#0f1f31",
    "editorWhitespace.foreground": "#1b3047",
    "editorRuler.foreground": "#0f1f31",
    "editorBracketMatch.background": "#3ee6d015",
    "editorBracketMatch.border": "#3ee6d080",
    "editorBracketHighlight.foreground1": "#3ee6d0",
    "editorBracketHighlight.foreground2": "#a78bfa",
    "editorBracketHighlight.foreground3": "#5fd0ff",
    "editorBracketHighlight.unexpectedBracket.foreground": "#e0459b",
    "editorError.foreground": "#ff5c8a",
    "editorWarning.foreground": "#f5c86b",
    "editorInfo.foreground": "#5fd0ff",
    "errorForeground": "#ff5c8a",
    "editorWidget.background": "#0a1624",
    "editorWidget.border": "#16314b",
    "editorStickyScroll.shadow": "#000000a0",

    "panel.background": "#060e19",
    "panel.border": "#0c1a29",
    "panelTitle.activeBorder": "#3ee6d0",
    "problemsErrorIcon.foreground": "#ff5c8a",
    "problemsWarningIcon.foreground": "#f5c86b",

    "statusBar.background": "linear-gradient(90deg, #0b2236, #050b14)",
    "statusBar.foreground": "#7f9ab0",
    "statusBar.border": "#0c1a29",
    "statusBarItem.branch.foreground": "#3ee6d0",

    "input.background": "#08121f",
    "input.border": "#16314b",
    "button.background": "#127a73",
    "button.foreground": "#e6fffb",
    "button.hoverBackground": "#18978e",
    "quickInput.background": "#0a1624",
    "quickInput.border": "#16314b",
    "scrollbarSlider.background": "#3ee6d01c",
    "scrollbarSlider.hoverBackground": "#3ee6d038",
    "minimapSlider.background": "#3ee6d014",
    "welcome.logo": "#3ee6d01a",
    "welcome.titleForeground": "#1f3a52",

    "gitDecoration.addedResourceForeground": "#4ade80",
    "gitDecoration.modifiedResourceForeground": "#5fd0ff",
    "gitDecoration.deletedResourceForeground": "#ff5c8a",
    "editorGutter.addedBackground": "#2fbf71",
    "editorGutter.modifiedBackground": "#2a7fff",
    "editorGutter.deletedBackground": "#e0459b"
  },

  "tokenColors": {
    "keyword": "#5fa8ff",
    "keyword - control": "#e070c0",
    "preprocessor keyword": "#4f687e",
    "comment": { "foreground": "#3f6079", "fontStyle": "italic" },
    "xml doc comment": { "foreground": "#3f6079", "fontStyle": "italic" },
    "excluded code": "#2c4257",
    "string": "#7fe0b0",
    "string - verbatim": "#7fe0b0",
    "string - escape character": "#f5c86b",
    "number": "#f5a06b",
    "operator": "#8fb3cf",
    "punctuation": "#6f8ca5",
    "identifier": "#c6d8e8",
    "namespace name": "#8fb3cf",
    "class name": "#3ee6d0",
    "record class name": "#3ee6d0",
    "struct name": "#5fe0c0",
    "record struct name": "#5fe0c0",
    "interface name": { "foreground": "#7fd8ff", "fontStyle": "italic" },
    "enum name": "#7fd8ff",
    "delegate name": "#3ee6d0",
    "type parameter name": { "foreground": "#7fd8ff", "fontStyle": "italic" },
    "method name": "#a78bfa",
    "extension method name": { "foreground": "#a78bfa", "fontStyle": "italic" },
    "property name": "#b9d4ec",
    "field name": "#9fc0dc",
    "event name": "#f5c86b",
    "local name": "#c6d8e8",
    "parameter name": { "foreground": "#d6e6f4", "fontStyle": "italic" },
    "constant name": "#f5a06b",
    "enum member name": "#f5a06b",
    "json - property name": "#5fd0ff",
    "json - string": "#7fe0b0",
    "html element name": "#5fa8ff",
    "html attribute name": "#a78bfa",
    "html attribute value": "#7fe0b0",
    "html tag delimiter": "#4f687e",
    "markup heading": { "foreground": "#3ee6d0", "fontStyle": "bold" },
    "markup code": "#7fe0b0",
    "markup link": { "foreground": "#5fd0ff", "fontStyle": "underline" }
  },

  "metrics": {
    "activityBar.indicatorLeft.border": "2,0,0,0",
    "tab.indicatorSize": 2,
    "list.radius": 4,
    "widget.radius": 8,
    "palette.radius": 12,
    "scrollbar.size": 10,
    "scrollbar.radius": 5,
    "scrollbar.thumbMargin": 2,
    "editorGutter.changeRadius": 2
  },

  "editor": {
    "cursorBlinking": "smooth",
    "smoothCaretAnimation": true,
    "lineHighlight": "gutter",
    "selectionRadius": 4,
    "squiggleStyle": "wavy"
  },

  "effects": {
    "palette.shadow": "0 0 40 0 #3ee6d02a, 0 16 40 0 #000000b0",
    "widget.shadow": "0 0 18 0 #3ee6d01c, 0 6 18 0 #00000090"
  },

  "layout": {
    "tab.indicatorPosition": "top"
  }
}
