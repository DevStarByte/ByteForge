  // Keys are Roslyn classification names. "a - b" falls back to "a" when not listed.
  // Value: a color, or { "foreground": "...", "fontStyle": "bold italic underline" }.
  "tokenColors": {
    "keyword": "#569cd6",
    "keyword - control": "#c586c0",
    "preprocessor keyword": "#9b9b9b",
    "preprocessor text": "#9b9b9b",
    "comment": { "foreground": "#6a9955", "fontStyle": "italic" },
    "xml doc comment": "#6a9955",
    "xml doc comment - name": "#4ec9b0",
    "xml doc comment - attribute name": "#9cdcfe",
    "excluded code": "#6b6b6b",
    "string": "#ce9178",
    "string - verbatim": "#ce9178",
    "string - escape character": "#d7ba7d",
    "number": "#b5cea8",
    "operator": "#d4d4d4",
    "operator - overloaded": "#dcdcaa",
    "punctuation": "#d4d4d4",
    "identifier": "#d4d4d4",
    "namespace name": "#d4d4d4",
    "class name": "#4ec9b0",
    "record class name": "#4ec9b0",
    "struct name": "#86c691",
    "record struct name": "#86c691",
    "interface name": "#b8d7a3",
    "enum name": "#b8d7a3",
    "delegate name": "#4ec9b0",
    "type parameter name": "#b8d7a3",
    "module name": "#4ec9b0",
    "method name": "#dcdcaa",
    "extension method name": "#dcdcaa",
    "property name": "#9cdcfe",
    "field name": "#9cdcfe",
    "event name": "#9cdcfe",
    "local name": "#9cdcfe",
    "parameter name": "#9cdcfe",
    "label name": "#c8c8c8",
    "constant name": "#4fc1ff",
    "enum member name": "#4fc1ff",
    "regex - character class": "#d16969",
    "regex - anchor": "#dcdcaa",
    "regex - quantifier": "#d7ba7d",
    "json - property name": "#9cdcfe",
    "json - string": "#ce9178"
  },

