  // ByteForge Dark: the reference theme. EVERY key the workbench understands is listed here.
  // Other themes inherit from this one and only override what they change ("inherits").
  // Saved changes apply instantly.
  //
  // Value formats
  //   colors      #RGB  #RRGGBB  #RRGGBBAA (alpha last)  named colors  transparent
  //               linear-gradient(90deg, #ff0080, #7928ca 60%, #2af598)   radial-gradient(#fff, #000)
  //   sizes       numbers in pixels
  //   keys ending in padding / margin / border / thickness  →  "all"  "h,v"  or  "left,top,right,bottom"
  //   keys ending in radius  →  "all" or "topLeft,topRight,bottomRight,bottomLeft"
  //   keys ending in shadow  →  "x y blur spread color" (comma separated for several), or "none"
  //   keys ending in weight  →  thin light normal medium semibold bold black, or 100..900
  "name": "ByteForge Dark",
  "type": "dark",
  "description": "Balanced default dark",

