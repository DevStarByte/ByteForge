  // Editor look & behavior.
  "editor": {
    "cursorStyle": "line",              // line | block | block-outline | underline
    "cursorBlinking": "smooth",         // blink | smooth | phase | solid
    "cursorBlinkInterval": 530,
    "cursorWidth": 2,
    "smoothCaretAnimation": true,       // caret glides between positions
    "animationSpeed": 0.05,             // easing time constant (s) for scrolling and caret
    "lineHighlight": "fill",            // fill | border | gutter | all | none
    "lineHighlightBorderWidth": 1,
    "selectionRadius": 3,
    "renderWhitespace": "none",         // none | leading | all
    "squiggleStyle": "wavy",            // wavy | line | dotted
    "bracketPairColorization": true,    // colors: editorBracketHighlight.foreground1..6
    "matchBrackets": true,
    "indentGuides": true,
    "indentGuideWidth": 1,
    "rulers": "",                       // e.g. "80,120"
    "textPadding": 8,
    "gutterPaddingLeft": 16,
    "gutterPaddingRight": 16
  },

  "effects": {
    "window.backdrop": "none",          // none | blur | transparent (mica/acrylic = blur). Use colors with alpha.
    "palette.shadow": "0 8 28 0 #00000070",
    "widget.shadow": "0 4 12 0 #00000050"
  },

  // Layout: every container is an ordered list of parts. Reorder parts to move them, leave them out to
  // hide them. Lists can be JSON arrays or comma-separated strings. Bars (title, activity, status) also take
  // any command: "command:<id>" or "command:<id>:<icon>" (e.g. "command:dotnet.build:build"), and "spacer".
  "layout": {
    "titleBar.style": "custom",         // custom | native (applies on the next start)

    // The values below are the defaults, shown commented out so themes that inherit this one can still use
    // the older keys listed at the end. Uncomment and edit a line to change that part of the layout.

    // Rows of the window, top to bottom: titleBar, main, statusBar.
    // "workbench.order": ["titleBar", "main", "statusBar"],
    // Columns of the main area, left to right: activityBar, sideBar, editor, panel (a panel listed here
    // becomes a side panel; otherwise it lives in editor.order).
    // "main.order": ["activityBar", "sideBar", "editor"],
    // The editor column, top to bottom: tabs, breadcrumbs, content, panel.
    // "editor.order": ["tabs", "breadcrumbs", "content", "panel"],
    // The side bar, top to bottom: header, content, activityBar (a horizontal activity bar).
    // "sideBar.order": ["header", "content"],
    // "sideBar.visible": true,            // initial visibility
    // "sideBar.defaultView": "explorer",  // explorer | search | scm | modules
    // "panel.visible": false,
    // "panel.tabs": ["problems", "output"],

    // Title bar zones. Parts: logo, menu, title, commandCenter, branch, layoutControls (= toggleSideBar,
    // togglePanel, themePicker), windowControls, spacer, commands. The center zone stays centered.
    // "titleBar.left": ["logo", "menu"],
    // "titleBar.center": ["commandCenter"],
    // "titleBar.right": ["layoutControls", "windowControls"],
    // "menuBar.menus": ["File", "Edit", "View", "Go", "Git", "Run", "Preferences", "Help"],

    // Activity bar items: explorer, search, scm, modules, settings, spacer, commands.
    // "activityBar.items": ["explorer", "search", "scm", "modules", "spacer", "settings"],

    // Status bar zones. Parts: branch, sync, problems (errors + warnings), errors, warnings, run, modules
    // (module items, placed by their alignment), position, indent, encoding, eol, language, lsp, spacer, commands.
    // "statusBar.left": ["branch", "sync", "problems", "run", "modules"],
    // "statusBar.center": [],
    // "statusBar.right": ["modules", "position", "indent", "encoding", "eol", "language", "lsp"],

    // "tab.indicatorPosition": "top",     // top | bottom: edge of the active tab that gets the indicator

    // Welcome page: parts (logo, title, shortcuts), its title, and the commands listed as shortcuts.
    // "welcome.order": ["logo", "title", "shortcuts"],
    // "welcome.title": "ByteForge",
    // "welcome.shortcuts": ["file.openFolder", "view.quickOpen", "view.commandPalette", "theme.select", "dotnet.build"]

    // Older keys still work as defaults when the lists above are not set: sideBar.position,
    // activityBar.position, activityBar.visible, statusBar.visible, tabs.visible, breadcrumbs.visible,
    // menuBar.visible, commandCenter.visible, titleBar.layoutControls.
  },

  // Replace any built-in icon with your own SVG path data (24x24 view box). Names: files, search, settings,
