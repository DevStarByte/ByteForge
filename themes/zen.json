{
  // Distraction-free layout showcase: only the editor and what you need to find your way. No activity bar
  // (Ctrl+Shift+E and the other view shortcuts still open the side bar), the side bar starts hidden, no
  // breadcrumbs or menu bar, a quiet status bar with just the branch, problems and cursor position, and wide
  // margins around the text. Muted charcoal with a soft sage accent.
  "name": "Zen",
  "type": "dark",
  "inherits": "ByteForge Dark",
  "description": "layout showcase: editor only, hidden bars, wide margins",

  "colors": {
    "accent": "#9cb89a",
    "focusBorder": "#9cb89a80",
    "window.background": "#1c1c1b",
    "window.foreground": "#cfcac0",
    "foreground.muted": "#7a766e",
    "icon.foreground": "#a8a397",
    "sash.hoverBorder": "#9cb89a",

    "titleBar.background": "#1c1c1b",
    "titleBar.foreground": "#a8a397",
    "titleBar.inactiveForeground": "#5e5b55",
    "titleBar.border": "transparent",
    "titleBar.logo": "#9cb89a",
    "commandCenter.background": "transparent",
    "commandCenter.foreground": "#7a766e",
    "commandCenter.border": "transparent",
    "commandCenter.hoverBorder": "#3a3936",
    "commandCenter.hoverBackground": "#252523",
    "windowControl.foreground": "#7a766e",
    "windowControl.hoverBackground": "#2a2a28",
    "menu.background": "#232322",
    "menu.selectionBackground": "#2f302c",
    "menu.border": "#333230",

    "sideBar.background": "#1a1a19",
    "sideBar.foreground": "#b5b0a5",
    "sideBar.border": "transparent",
    "sideBarTitle.foreground": "#7a766e",
    "sideBarSectionHeader.foreground": "#7a766e",
    "list.hoverBackground": "#232322",
    "list.activeSelectionBackground": "#2a2b27",
    "list.activeFileBackground": "#2a2b27",
    "list.activeFileIndicator": "#9cb89a",
    "icon.folder": "#a8a397",
    "icon.csharp": "#a8a397",
    "icon.project": "#9cb89a",
    "icon.json": "#a8a397",
    "icon.markdown": "#a8a397",

    "editorGroupHeader.background": "#1c1c1b",
    "editorGroupHeader.border": "transparent",
    "tab.activeBackground": "#1c1c1b",
    "tab.activeForeground": "#e2ddd2",
    "tab.inactiveBackground": "#1c1c1b",
    "tab.inactiveForeground": "#5e5b55",
    "tab.hoverBackground": "#1c1c1b",
    "tab.border": "transparent",
    "tab.activeBorderTop": "transparent",
    "tab.activeBorder": "#9cb89a",
    "tab.modifiedIndicator": "#c8a46a",

    "editor.background": "#1c1c1b",
    "editor.foreground": "#cfcac0",
    "editorGutter.background": "#1c1c1b",
    "editor.lineHighlightBackground": "#1c1c1b",
    "editor.lineHighlightBorder": "transparent",
    "editor.selectionBackground": "#3b4038",
    "editor.inactiveSelectionBackground": "#2e312c",
    "editor.findMatchBackground": "#c8a46a40",
    "editor.wordHighlightBackground": "#ffffff0a",
    "editorCursor.foreground": "#9cb89a",
    "editorLineNumber.foreground": "#353432",
    "editorLineNumber.activeForeground": "#7a766e",
    "editorIndentGuide.background": "#252523",
    "editorWhitespace.foreground": "#2f2e2b",
    "editorRuler.foreground": "#242422",
    "editorBracketMatch.background": "transparent",
    "editorBracketMatch.border": "#9cb89a60",
    "editorError.foreground": "#d0846f",
    "editorWarning.foreground": "#c8a46a",
    "editorInfo.foreground": "#8fa8b8",
    "errorForeground": "#d0846f",
    "editorWidget.background": "#232322",
    "editorWidget.border": "#333230",

    "panel.background": "#1a1a19",
    "panel.border": "#2a2a28",
    "panelTitle.activeBorder": "#9cb89a",

    "statusBar.background": "#1c1c1b",
    "statusBar.foreground": "#5e5b55",
    "statusBar.border": "transparent",
    "statusBarItem.branch.foreground": "#7a766e",

    "input.background": "#232322",
    "input.border": "#333230",
    "button.background": "#4a5a48",
    "button.hoverBackground": "#5a6c58",
    "quickInput.background": "#232322",
    "quickInput.border": "#333230",
    "scrollbarSlider.background": "#ffffff0c",
    "scrollbarSlider.hoverBackground": "#ffffff1c",
    "welcome.logo": "#9cb89a14",
    "welcome.titleForeground": "#3a3936",

    "editorGutter.addedBackground": "#7d9a72",
    "editorGutter.modifiedBackground": "#8fa8b8",
    "editorGutter.deletedBackground": "#d0846f"
  },

  "tokenColors": {
    "keyword": "#9cb89a",
    "keyword - control": "#9cb89a",
    "preprocessor keyword": "#6a665e",
    "comment": { "foreground": "#6a665e", "fontStyle": "italic" },
    "xml doc comment": { "foreground": "#6a665e", "fontStyle": "italic" },
    "excluded code": "#4a4843",
    "string": "#c8a46a",
    "string - verbatim": "#c8a46a",
    "string - escape character": "#d0846f",
    "number": "#d0846f",
    "operator": "#a8a397",
    "punctuation": "#7a766e",
    "identifier": "#cfcac0",
    "namespace name": "#a8a397",
    "class name": "#8fa8b8",
    "record class name": "#8fa8b8",
    "struct name": "#8fa8b8",
    "record struct name": "#8fa8b8",
    "interface name": "#8fa8b8",
    "enum name": "#8fa8b8",
    "delegate name": "#8fa8b8",
    "type parameter name": "#8fa8b8",
    "method name": "#e2ddd2",
    "extension method name": "#e2ddd2",
    "property name": "#cfcac0",
    "field name": "#cfcac0",
    "local name": "#cfcac0",
    "parameter name": "#cfcac0",
    "constant name": "#d0846f",
    "enum member name": "#d0846f",
    "json - property name": "#9cb89a",
    "json - string": "#c8a46a",
    "markup heading": { "foreground": "#9cb89a", "fontStyle": "bold" },
    "markup code": "#c8a46a",
    "markup link": { "foreground": "#8fa8b8", "fontStyle": "underline" }
  },

  "fonts": {
    "editor.lineHeight": 1.85,
    "tab.activeWeight": "normal",
    "statusBar.fontSize": 11,
    "welcome.titleWeight": "light"
  },

  "metrics": {
    "titleBar.height": 34,
    "titleBar.borderThickness": 0,
    "tab.height": 34,
    "tab.indicatorSize": 1,
    "tab.indicatorRadius": 0,
    "editorGroupHeader.borderThickness": 0,
    "statusBar.height": 24,
    "statusBar.borderThickness": 0,
    "panel.borderThickness": "0,1,0,0",
    "scrollbar.size": 8,
    "scrollbar.radius": 4,
    "scrollbar.thumbMargin": 2,
    "editorGutter.changeWidth": 2
  },

  "editor": {
    "cursorBlinking": "smooth",
    "smoothCaretAnimation": true,
    "lineHighlight": "none",
    "bracketPairColorization": false,
    "indentGuides": false,
    "squiggleStyle": "dotted",
    "textPadding": 48,
    "gutterPaddingLeft": 32,
    "gutterPaddingRight": 24
  },

  "effects": {
    "palette.shadow": "0 20 60 0 #000000a0",
    "widget.shadow": "0 8 24 0 #00000070"
  },

  "layout": {
    "main.order": ["sideBar", "editor"],
    "editor.order": ["tabs", "content", "panel"],
    "sideBar.visible": false,
    "titleBar.left": ["logo"],
    "titleBar.center": ["commandCenter"],
    "titleBar.right": ["windowControls"],
    "statusBar.left": ["branch", "problems"],
    "statusBar.center": [],
    "statusBar.right": ["position"],
    "tab.indicatorPosition": "bottom",
    "welcome.shortcuts": ["file.openFolder", "view.quickOpen", "view.commandPalette", "theme.select"]
  }
}
