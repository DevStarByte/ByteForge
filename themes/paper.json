{
  // Editorial light theme: warm paper, near-black ink and a single vermilion accent. Serif interface, flat
  // shapes without rounding, hairline rules instead of filled bars, and a gutter-only line highlight so the
  // text area stays as clean as a printed page. Syntax is mostly ink: weight and italics do the work, color
  // is kept for strings, numbers and types.
  "name": "Paper",
  "type": "light",
  "inherits": "ByteForge Light",
  "description": "Ink on warm paper, serif UI, one red accent",

  "colors": {
    "accent": "#c8402a",
    "focusBorder": "#c8402a",
    "window.background": "#f6f1e7",
    "window.foreground": "#2b2722",
    "foreground.muted": "#8a8174",
    "icon.foreground": "#4a443c",
    "sash.hoverBorder": "#c8402a",

    "titleBar.background": "#f6f1e7",
    "titleBar.foreground": "#2b2722",
    "titleBar.inactiveForeground": "#8a8174",
    "titleBar.border": "#ddd4c4",
    "titleBar.logo": "#c8402a",
    "commandCenter.background": "#efe8db",
    "commandCenter.foreground": "#6b6357",
    "commandCenter.border": "#ddd4c4",
    "commandCenter.hoverBorder": "#c9bea9",
    "commandCenter.hoverBackground": "#ebe3d4",
    "windowControl.hoverBackground": "#ebe3d4",
    "windowControl.closeHoverBackground": "#c8402a",
    "windowControl.closeHoverForeground": "#fbf8f2",
    "menu.background": "#fbf8f2",
    "menu.foreground": "#2b2722",
    "menu.selectionBackground": "#efe5d3",
    "menu.border": "#ddd4c4",

    "activityBar.background": "#f6f1e7",
    "activityBar.foreground": "#2b2722",
    "activityBar.inactiveForeground": "#a69d8f",
    "activityBar.activeBorder": "#c8402a",
    "activityBar.activeBackground": "transparent",
    "activityBar.hoverBackground": "#efe8db",
    "activityBar.border": "#ddd4c4",
    "activityBarBadge.background": "#c8402a",
    "activityBarBadge.foreground": "#fbf8f2",
    "badge.background": "#2b2722",
    "badge.foreground": "#fbf8f2",

    "sideBar.background": "#f2ecdf",
    "sideBar.foreground": "#2b2722",
    "sideBar.border": "#ddd4c4",
    "sideBarTitle.foreground": "#2b2722",
    "sideBarSectionHeader.foreground": "#8a8174",
    "list.hoverBackground": "#ebe3d4",
    "list.activeSelectionBackground": "#e5dac6",
    "list.activeSelectionForeground": "#1d1a16",
    "list.activeFileBackground": "#e5dac6",
    "list.activeFileForeground": "#1d1a16",
    "list.activeFileIndicator": "#c8402a",
    "icon.folder": "#8a6d45",
    "icon.csharp": "#5a4a8a",
    "icon.project": "#c8402a",
    "icon.json": "#a2711b",
    "icon.markdown": "#2f6a7a",

    "editorGroupHeader.background": "#f2ecdf",
    "editorGroupHeader.border": "#ddd4c4",
    "tab.activeBackground": "#fbf8f2",
    "tab.activeForeground": "#1d1a16",
    "tab.inactiveBackground": "#f2ecdf",
    "tab.inactiveForeground": "#8a8174",
    "tab.hoverBackground": "#f6f1e7",
    "tab.border": "#ddd4c4",
    "tab.activeBorderTop": "#c8402a",
    "tab.modifiedIndicator": "#c8402a",
    "breadcrumb.background": "#fbf8f2",
    "breadcrumb.foreground": "#a69d8f",
    "breadcrumb.activeForeground": "#2b2722",

    "editor.background": "#fbf8f2",
    "editor.foreground": "#2b2722",
    "editorGutter.background": "#fbf8f2",
    "editor.lineHighlightBackground": "#f1ead9",
    "editor.lineHighlightBorder": "transparent",
    "editor.selectionBackground": "#f0d9b8",
    "editor.inactiveSelectionBackground": "#f3e6d0",
    "editor.findMatchBackground": "#f5c66a80",
    "editor.findMatchBorder": "#c8402a",
    "editor.wordHighlightBackground": "#e8dfcc",
    "editorCursor.foreground": "#c8402a",
    "editorLineNumber.foreground": "#c9bea9",
    "editorLineNumber.activeForeground": "#2b2722",
    "editorIndentGuide.background": "#ebe3d4",
    "editorWhitespace.foreground": "#d6ccb9",
    "editorRuler.foreground": "#ebe3d4",
    "editorBracketMatch.background": "transparent",
    "editorBracketMatch.border": "#c8402a80",
    "editorBracketHighlight.foreground1": "#4a443c",
    "editorBracketHighlight.foreground2": "#8a6d45",
    "editorBracketHighlight.foreground3": "#2f6a7a",
    "editorError.foreground": "#c8402a",
    "editorWarning.foreground": "#b07a10",
    "editorInfo.foreground": "#2f6a7a",
    "errorForeground": "#c8402a",
    "editorWidget.background": "#fbf8f2",
    "editorWidget.border": "#d6ccb9",

    "panel.background": "#f6f1e7",
    "panel.border": "#ddd4c4",
    "panelTitle.activeBorder": "#c8402a",
    "problemsErrorIcon.foreground": "#c8402a",
    "problemsWarningIcon.foreground": "#b07a10",

    "statusBar.background": "#f6f1e7",
    "statusBar.foreground": "#6b6357",
    "statusBar.border": "#ddd4c4",
    "statusBarItem.branch.foreground": "#c8402a",

    "input.background": "#fbf8f2",
    "input.border": "#d6ccb9",
    "button.background": "#2b2722",
    "button.foreground": "#fbf8f2",
    "button.hoverBackground": "#c8402a",
    "quickInput.background": "#fbf8f2",
    "quickInput.border": "#d6ccb9",
    "scrollbarSlider.background": "#c9bea966",
    "scrollbarSlider.hoverBackground": "#b3a790",
    "welcome.logo": "#c8402a1c",
    "welcome.titleForeground": "#2b2722",

    "gitDecoration.addedResourceForeground": "#4f7a3a",
    "gitDecoration.modifiedResourceForeground": "#a2711b",
    "gitDecoration.deletedResourceForeground": "#c8402a",
    "editorGutter.addedBackground": "#7fa36a",
    "editorGutter.modifiedBackground": "#d1a44a",
    "editorGutter.deletedBackground": "#c8402a"
  },

  "tokenColors": {
    "keyword": { "foreground": "#1d1a16", "fontStyle": "bold" },
    "keyword - control": { "foreground": "#1d1a16", "fontStyle": "bold" },
    "preprocessor keyword": "#8a8174",
    "comment": { "foreground": "#9a8f7e", "fontStyle": "italic" },
    "xml doc comment": { "foreground": "#9a8f7e", "fontStyle": "italic" },
    "excluded code": "#b8ad99",
    "string": "#4f7a3a",
    "string - verbatim": "#4f7a3a",
    "string - escape character": "#a2711b",
    "number": "#a2711b",
    "operator": "#4a443c",
    "punctuation": "#6b6357",
    "identifier": "#2b2722",
    "namespace name": "#6b6357",
    "class name": "#5a4a8a",
    "record class name": "#5a4a8a",
    "struct name": "#5a4a8a",
    "record struct name": "#5a4a8a",
    "interface name": { "foreground": "#5a4a8a", "fontStyle": "italic" },
    "enum name": "#5a4a8a",
    "delegate name": "#5a4a8a",
    "type parameter name": { "foreground": "#5a4a8a", "fontStyle": "italic" },
    "method name": "#2f6a7a",
    "extension method name": { "foreground": "#2f6a7a", "fontStyle": "italic" },
    "property name": "#2b2722",
    "field name": "#2b2722",
    "local name": "#2b2722",
    "parameter name": { "foreground": "#2b2722", "fontStyle": "italic" },
    "constant name": "#c8402a",
    "enum member name": "#c8402a",
    "json - property name": "#2f6a7a",
    "json - string": "#4f7a3a",
    "html element name": { "foreground": "#1d1a16", "fontStyle": "bold" },
    "html attribute name": "#2f6a7a",
    "html attribute value": "#4f7a3a",
    "html tag delimiter": "#a69d8f",
    "markup heading": { "foreground": "#c8402a", "fontStyle": "bold" },
    "markup code": "#4f7a3a",
    "markup link": { "foreground": "#2f6a7a", "fontStyle": "underline" }
  },

  "fonts": {
    "ui.family": "Source Serif 4, Charter, Georgia, Noto Serif, DejaVu Serif, serif, default",
    "ui.size": 14,
    "tab.style": "italic",
    "sideBarTitle.weight": "bold",
    "welcome.titleSize": 52,
    "welcome.titleWeight": "normal",
    "editor.lineHeight": 1.7
  },

  "metrics": {
    "activityBar.itemRadius": 0,
    "activityBar.itemInset": 0,
    "activityBar.indicatorLeft.border": "2,0,0,0",
    "list.radius": 0,
    "list.itemMargin": "0,0",
    "tab.radius": 0,
    "tab.indicatorSize": 2,
    "tab.indicatorRadius": 0,
    "commandCenter.radius": 0,
    "menuBarItem.radius": 0,
    "titleIcon.radius": 0,
    "panelTab.radius": 0,
    "widget.radius": 0,
    "palette.radius": 0,
    "input.radius": 0,
    "button.radius": 0,
    "scrollbar.size": 10,
    "editor.caretWidth": 2
  },

  "editor": {
    "cursorStyle": "line",
    "cursorBlinking": "smooth",
    "lineHighlight": "gutter",
    "selectionRadius": 0,
    "squiggleStyle": "line",
    "bracketPairColorization": false,
    "rulers": "100",
    "textPadding": 14
  },

  "effects": {
    "palette.shadow": "0 10 30 0 #3b2f1a30",
    "widget.shadow": "0 4 14 0 #3b2f1a22"
  },

  "layout": {
    "tab.indicatorPosition": "top",
    "welcome.title": "ByteForge"
  }
}
