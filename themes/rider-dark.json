{
  // Rider Dark: the look of JetBrains Rider's new UI in its dark theme. A main toolbar with the project badge,
  // the branch and the run configuration (green Run and Debug), an icon-only tool window stripe, flat tabs
  // with a blue underline, the file's path in the status bar instead of breadcrumbs, a guide at column 120,
  // and Rider's syntax colors. ByteForge's own logo and icons stay. Install JetBrains Mono (free) for the
  // editor font; until then Cascadia or Consolas stands in.
  //
  // Palette: editor #1E1F22  tool windows #2B2D30  controls #393B40 / #43454A  borders #1E1F22 / #4E5157
  //          text #DFE1E5  code #BCBEC4  muted #868A91  accent #3574F0  run #57965C  error #F75464
  "name": "Rider Dark",
  "type": "dark",
  "inherits": "ByteForge Dark",
  "description": "JetBrains Rider's new UI in dark: project, branch and run widgets in the toolbar",

  "colors": {
    "accent": "#3574f0",
    "focusBorder": "#3574f0",
    "window.background": "#2b2d30",
    "window.foreground": "#dfe1e5",
    "foreground.muted": "#868a91",
    "icon.foreground": "#ced0d6",
    "overlay.background": "#00000059",
    "toolbar.hoverBackground": "#393b40",
    "sash.hoverBorder": "#3574f0",

    // ── main toolbar ──
    "titleBar.background": "#2b2d30",
    "titleBar.foreground": "#dfe1e5",
    "titleBar.inactiveForeground": "#868a91",
    "titleBar.border": "#1e1f22",
    "titleBar.logo": "#ced0d6",
    "titleBar.runForeground": "#57965c",
    "titleBar.debugForeground": "#57965c",
    "titleBar.stopForeground": "#db5c5c",
    "titleIcon.activeForeground": "#ffffff",
    "windowControl.foreground": "#ced0d6",
    "windowControl.hoverBackground": "#393b40",
    "windowControl.closeHoverBackground": "#c94f4f",
    "windowControl.closeHoverForeground": "#ffffff",
    "menu.background": "#2b2d30",
    "menu.foreground": "#dfe1e5",
    "menu.selectionBackground": "#2e436e",
    "menu.border": "#43454a",

    // ── tool window stripe ──
    "activityBar.background": "#2b2d30",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#ced0d6",
    "activityBar.activeBorder": "transparent",
    "activityBar.activeBackground": "#3574f0",
    "activityBar.activeIconForeground": "#ffffff",
    "activityBar.hoverBackground": "#393b40",
    "activityBar.border": "#1e1f22",
    "activityBarBadge.background": "#3574f0",
    "activityBarBadge.foreground": "#ffffff",

    // ── tool windows ──
    "sideBar.background": "#2b2d30",
    "sideBar.foreground": "#dfe1e5",
    "sideBar.border": "#1e1f22",
    "sideBarTitle.foreground": "#dfe1e5",
    "sideBarSectionHeader.foreground": "#dfe1e5",
    "list.hoverBackground": "#2e3033",
    "list.activeSelectionBackground": "#2e436e",
    "list.activeSelectionForeground": "#ffffff",
    "list.activeFileBackground": "#2e436e",
    "list.activeFileForeground": "#ffffff",
    "list.activeFileIndicator": "transparent",
    "terminal.background": "#1e1f22",
    "terminal.foreground": "#bcbec4",
    "terminalCursor.foreground": "#ced0d6",
    "terminal.selectionBackground": "#214283",

    // ── file icons ──
    "icon.folder": "#9da0a8",
    "icon.file": "#9da0a8",
    "icon.csharp": "#a77bf3",
    "icon.project": "#57965c",
    "icon.solution": "#a77bf3",
    "icon.json": "#d5b778",
    "icon.markup": "#e08855",
    "icon.markdown": "#548af7",
    "icon.razor": "#c77dbb",
    "icon.yaml": "#db5c5c",
    "icon.config": "#9da0a8",
    "icon.text": "#9da0a8",
    "icon.shell": "#57965c",
    "icon.script": "#d5b778",
    "icon.style": "#548af7",
    "icon.image": "#2aacb8",

    // ── editor tabs (no breadcrumb bar: the path is in the status bar) ──
    "editorGroupHeader.background": "#1e1f22",
    "editorGroupHeader.border": "#2b2d30",
    "tab.activeBackground": "#1e1f22",
    "tab.activeForeground": "#dfe1e5",
    "tab.activeBorder": "transparent",
    "tab.inactiveBackground": "#1e1f22",
    "tab.inactiveForeground": "#a8adbd",
    "tab.hoverBackground": "#26282e",
    "tab.border": "transparent",
    "tab.activeBorderTop": "#3574f0",
    "tab.modifiedIndicator": "#ced0d6",

    // ── editor ──
    "editor.background": "#1e1f22",
    "editor.foreground": "#bcbec4",
    "editor.lineHighlightBackground": "#26282e",
    "editor.lineHighlightBorder": "transparent",
    "editor.selectionBackground": "#214283",
    "editor.inactiveSelectionBackground": "#2b3550",
    "editor.findMatchBackground": "#32593d",
    "editor.findMatchBorder": "transparent",
    "editor.wordHighlightBackground": "#373b39",
    "editor.wordHighlightStrongBackground": "#40332b",
    "editorInlayHint.foreground": "#8c8f96",
    "editorInlayHint.background": "#43454a66",
    "editorCursor.foreground": "#ced0d6",
    "editorCursor.background": "#1e1f22",
    "editorLineNumber.foreground": "#4b5059",
    "editorLineNumber.activeForeground": "#a1a3ab",
    "editorGutter.background": "#1e1f22",
    "editorIndentGuide.background": "#313438",
    "editorWhitespace.foreground": "#6f737a59",
    "editorRuler.foreground": "#393b40",
    "editorBracketMatch.background": "#43454a",
    "editorBracketMatch.border": "transparent",
    "editorError.foreground": "#f75464",
    "editorWarning.foreground": "#e0b24c",
    "editorInfo.foreground": "#548af7",
    "editorCodeLens.foreground": "#868a91",
    "editorWidget.background": "#2b2d30",
    "editorWidget.border": "#43454a",
    "editorHoverWidget.background": "#2b2d30",
    "editorHoverWidget.foreground": "#dfe1e5",
    "editorHoverWidget.border": "#43454a",
    "minimap.background": "#1e1f22",

    // ── git ──
    "editorGutter.addedBackground": "#549159",
    "editorGutter.modifiedBackground": "#375fad",
    "editorGutter.deletedBackground": "#868a91",
    "diffEditor.insertedLineBackground": "#29443699",
    "diffEditor.removedLineBackground": "#5e383899",
    "diffEditor.insertedTextBackground": "#3d6a4a",
    "diffEditor.removedTextBackground": "#7a3e3e",
    "diffEditor.hunkHeaderBackground": "#3574f022",
    "diffEditor.diagonalFill": "#2b2d30",
    "merge.currentHeaderBackground": "#294436",
    "merge.incomingHeaderBackground": "#253a5b",
    "gitDecoration.addedResourceForeground": "#73bd79",
    "gitDecoration.modifiedResourceForeground": "#70aeff",
    "gitDecoration.stageModifiedResourceForeground": "#70aeff",
    "gitDecoration.deletedResourceForeground": "#868a91",
    "gitDecoration.renamedResourceForeground": "#70aeff",
    "gitDecoration.untrackedResourceForeground": "#d5756c",
    "gitDecoration.conflictingResourceForeground": "#de6a66",
    "badge.background": "#43454a",
    "badge.foreground": "#dfe1e5",
    "errorForeground": "#f75464",

    // ── bottom tool windows ──
    "panel.background": "#2b2d30",
    "panel.border": "#1e1f22",
    "panelTitle.activeForeground": "#dfe1e5",
    "panelTitle.inactiveForeground": "#a8adbd",
    "panelTitle.activeBorder": "#3574f0",
    "panelTitle.activeBackground": "transparent",
    "problemsErrorIcon.foreground": "#f75464",
    "problemsWarningIcon.foreground": "#e0b24c",
    "problemsInfoIcon.foreground": "#548af7",

    // ── status bar ──
    "statusBar.background": "#2b2d30",
    "statusBar.debuggingBackground": "#2b2d30",
    "statusBar.foreground": "#a8adbd",
    "statusBar.border": "#1e1f22",
    "statusBarItem.hoverBackground": "#393b40",
    "statusBarItem.path.foreground": "#ced0d6",

    // ── controls ──
    "input.background": "#2b2d30",
    "input.foreground": "#dfe1e5",
    "input.border": "#4e5157",
    "input.placeholderForeground": "#6f737a",
    "button.background": "#3574f0",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#3369d6",
    "button.secondaryBackground": "transparent",
    "button.border": "#4e5157",
    "scrollbarSlider.background": "#5a5d6380",
    "scrollbarSlider.hoverBackground": "#6f737ab3",
    "scrollbarSlider.activeBackground": "#868a91b3",
    "quickInput.background": "#2b2d30",
    "quickInput.foreground": "#dfe1e5",
    "quickInput.border": "#43454a",

    "welcome.logo": "#3574f026",
    "welcome.titleForeground": "#6f737a",
    "welcome.foreground": "#868a91"
  },

  // Rider's C# colors: orange keywords, green strings, purple types, teal methods, cyan members.
  "tokenColors": {
    "keyword": "#cf8e6d",
    "keyword - control": "#cf8e6d",
    "preprocessor keyword": "#b3ae60",
    "preprocessor text": "#b3ae60",
    "comment": "#7a7e85",
    "xml doc comment": { "foreground": "#5f826b", "fontStyle": "italic" },
    "xml doc comment - name": { "foreground": "#67a37c", "fontStyle": "italic" },
    "xml doc comment - attribute name": { "foreground": "#5f826b", "fontStyle": "italic" },
    "excluded code": "#5a5d63",
    "string": "#6aab73",
    "string - verbatim": "#6aab73",
    "string - escape character": "#cf8e6d",
    "number": "#2aacb8",
    "operator": "#bcbec4",
    "operator - overloaded": "#39cc9b",
    "punctuation": "#bcbec4",
    "identifier": "#bcbec4",
    "namespace name": "#bcbec4",
    "class name": "#c191ff",
    "record class name": "#c191ff",
    "struct name": "#e1bfff",
    "record struct name": "#e1bfff",
    "interface name": "#c191ff",
    "enum name": "#e1bfff",
    "delegate name": "#c191ff",
    "type parameter name": "#e1bfff",
    "module name": "#c191ff",
    "method name": "#39cc9b",
    "extension method name": "#39cc9b",
    "property name": "#66c3cc",
    "field name": "#66c3cc",
    "event name": "#ed94c0",
    "local name": "#bcbec4",
    "parameter name": "#bcbec4",
    "label name": "#bcbec4",
    "constant name": "#66c3cc",
    "enum member name": "#66c3cc",
    "regex - character class": "#42c3d4",
    "regex - anchor": "#cf8e6d",
    "regex - quantifier": "#cf8e6d",
    "json - property name": "#c77dbb",
    "json - string": "#6aab73",
    "html element name": "#d5b778",
    "html attribute name": "#bcbec4",
    "html attribute value": "#6aab73",
    "html tag delimiter": "#d5b778",
    "razor transition": "#cf8e6d",
    "razor directive": "#cf8e6d",
    "xml - msbuild reference": "#39cc9b"
  },

  "fonts": {
    "ui.family": "Inter, default",
    "ui.size": 13,
    "ui.smallSize": 11,
    "menuBar.fontSize": 13,
    "tab.fontSize": 13,
    "tab.activeWeight": "normal",
    "sideBarTitle.fontSize": 13,
    "sideBarTitle.weight": "semibold",
    "sideBarTitle.textTransform": "none",
    "sideBarSectionHeader.fontSize": 13,
    "sideBarSectionHeader.textTransform": "none",
    "panelTab.fontSize": 13,
    "list.fontSize": 13,
    "statusBar.fontSize": 13,
    "titleWidget.weight": "semibold",
    "editor.family": "JetBrains Mono, Cascadia Mono, Cascadia Code, Consolas, DejaVu Sans Mono, monospace",
    "editor.size": 13,
    "editor.lineHeight": 1.2,
    "editor.lineNumberSize": 12
  },

  "metrics": {
    // ── main toolbar ──
    "titleBar.height": 40,
    "titleBar.titleFontSize": 13,
    "titleBar.iconSize": 18,
    "titleBar.spacing": 4,
    "titleBar.branchChevron": 1,
    "titleIcon.padding": 6,
    "titleIcon.radius": 6,
    "titleIcon.inactiveOpacity": 1,
    "titleWidget.paddingX": 8,
    "titleWidget.spacing": 6,
    "projectBadge.size": 20,
    "projectBadge.radius": 4,
    "projectBadge.fontSize": 10,
    "menuBarItem.padding": "7,4",
    "menuBarItem.radius": 4,

    // ── tool window stripe: icons only, the active one filled ──
    "activityBar.width": 40,
    "activityBar.itemHeight": 32,
    "activityBar.iconSize": 18,
    "activityBar.spacing": 4,
    "activityBar.itemRadius": 6,
    "activityBar.labelSize": 0,
    "activityBar.itemInset": 4,
    "activityBar.indicatorLeft.border": 0,
    "activityBar.indicatorRight.border": 0,

    // ── tool windows & trees ──
    "sideBar.width": 280,
    "sideBarHeader.height": 40,
    "sideBarHeader.padding": "12,0",
    "explorer.iconSize": 16,
    "explorer.itemSpacing": 6,
    "list.itemHeight": 24,
    "list.itemPadding": "6,0",
    "list.itemMargin": "6,0",
    "list.radius": 4,

    // ── editor tabs ──
    "tab.height": 38,
    "tab.padding": "12,0,8,0",
    "tab.radius": 0,
    "tab.minWidth": 80,
    "tab.indicatorSize": 2,
    "tab.indicatorRadius": 0,
    "tab.closeRadius": 4,
    "editorGroupHeader.borderThickness": "0,0,0,1",

    // ── bottom tool windows & status bar ──
    "panelHeader.height": 38,
    "panelTab.padding": "8,6",
    "panelTab.margin": "4,0",
    "panelTab.radius": 0,
    "panelTab.indicator.border": "0,0,0,2",
    "statusBar.height": 28,
    "statusBarItem.padding": "8,0",
    "statusBarItem.radius": 4,

    // ── popups & controls ──
    "widget.radius": 8,
    "palette.width": 680,
    "palette.radius": 10,
    "palette.margin": "0,56,0,0",
    "input.radius": 4,
    "button.radius": 4,
    "scrollbar.size": 10,
    "scrollbar.radius": 5,
    "scrollbar.thumbMargin": 2,
    "editorGutter.changeWidth": 4,
    "editorGutter.changeOffset": 4,
    "editor.caretWidth": 2
  },

  "editor": {
    "cursorStyle": "line",
    "cursorBlinking": "blink",
    "smoothCaretAnimation": true,
    "lineHighlight": "fill",
    "selectionRadius": 0,
    "squiggleStyle": "wavy",
    "bracketPairColorization": false,
    "indentGuides": true,
    "rulers": "120",
    "textPadding": 6,
    "gutterPaddingLeft": 10,
    "gutterPaddingRight": 14
  },

  "effects": {
    "palette.shadow": "0 8 24 0 #00000080",
    "widget.shadow": "0 4 14 0 #00000066"
  },

  "layout": {
    // The main toolbar: menus, project and branch on the left; the run configuration with Run and Debug,
    // then Search Everywhere (the command palette) and Settings on the right. No centered search box.
    "titleBar.left": ["logo", "menu", "project", "branch"],
    "titleBar.center": [],
    "titleBar.right": ["launchProfile", "run", "debug", "command:view.commandPalette:search", "command:settings.open:settings", "windowControls"],

    // Tool window stripe: the main tool windows on top, the bottom ones (Terminal, Problems) below.
    "activityBar.items": ["solution", "explorer", "scm", "testing", "debug", "tasks", "modules", "spacer", "command:terminal.toggle:terminal", "command:view.problems:warning"],

    // No breadcrumb bar: the status bar shows where the file is.
    "editor.order": ["tabs", "content", "panel"],
    "tab.indicatorPosition": "bottom",

    "statusBar.left": ["path"],
    "statusBar.center": [],
    "statusBar.right": ["update", "modules", "position", "eol", "encoding", "indent", "lsp"],
    "statusBar.positionFormat": "{line}:{col}"
  }
}
