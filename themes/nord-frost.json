{
  // Arctic, calm blues. Leading whitespace dots, a ruler at 100, straight squiggles.
  "name": "Nord Frost",
  "type": "dark",
  "inherits": "ByteForge Dark",
  "description": "Arctic blue, calm and soft",

  "colors": {
    "accent": "#88c0d0",
    "focusBorder": "#88c0d0",
    "window.background": "#2e3440",
    "window.foreground": "#d8dee9",
    "foreground.muted": "#7b88a1",
    "icon.foreground": "#d8dee9",
    "sash.hoverBorder": "#88c0d0",

    "titleBar.background": "#2e3440",
    "titleBar.foreground": "#d8dee9",
    "titleBar.border": "#3b4252",
    "titleBar.logo": "#88c0d0",
    "commandCenter.background": "#3b4252",
    "commandCenter.border": "#434c5e",
    "commandCenter.hoverBorder": "#4c566a",
    "commandCenter.hoverBackground": "#434c5e",
    "menu.background": "#3b4252",
    "menu.selectionBackground": "#434c5e",
    "menu.border": "#4c566a",

    "activityBar.background": "#2e3440",
    "activityBar.foreground": "#eceff4",
    "activityBar.inactiveForeground": "#7b88a1",
    "activityBar.activeBorder": "#88c0d0",
    "activityBar.border": "#3b4252",

    "sideBar.background": "#2e3440",
    "sideBar.foreground": "#d8dee9",
    "sideBar.border": "#3b4252",
    "sideBarTitle.foreground": "#8fbcbb",
    "sideBarSectionHeader.foreground": "#88c0d0",
    "list.hoverBackground": "#3b4252",
    "list.activeSelectionBackground": "#434c5e",
    "icon.folder": "#81a1c1",
    "icon.csharp": "#b48ead",
    "icon.project": "#8fbcbb",
    "icon.json": "#ebcb8b",

    "editorGroupHeader.background": "#2e3440",
    "editorGroupHeader.border": "#3b4252",
    "tab.activeBackground": "#3b4252",
    "tab.activeForeground": "#eceff4",
    "tab.inactiveBackground": "#2e3440",
    "tab.inactiveForeground": "#7b88a1",
    "tab.hoverBackground": "#3b4252",
    "tab.border": "#3b4252",
    "tab.activeBorderTop": "#88c0d0",
    "breadcrumb.background": "#3b4252",

    "editor.background": "#3b4252",
    "editor.foreground": "#d8dee9",
    "editor.lineHighlightBackground": "#434c5e70",
    "editor.lineHighlightBorder": "transparent",
    "editor.selectionBackground": "#4c566acc",
    "editor.findMatchBackground": "#88c0d040",
    "editorCursor.foreground": "#d8dee9",
    "editorLineNumber.foreground": "#4c566a",
    "editorLineNumber.activeForeground": "#d8dee9",
    "editorGutter.background": "#3b4252",
    "editorIndentGuide.background": "#434c5e",
    "editorWhitespace.foreground": "#4c566aa0",
    "editorRuler.foreground": "#434c5e",
    "editorBracketHighlight.foreground1": "#88c0d0",
    "editorBracketHighlight.foreground2": "#b48ead",
    "editorBracketHighlight.foreground3": "#ebcb8b",
    "editorError.foreground": "#bf616a",
    "editorWarning.foreground": "#ebcb8b",
    "editorInfo.foreground": "#88c0d0",
    "editorWidget.background": "#2e3440",
    "editorWidget.border": "#4c566a",

    "panel.background": "#2e3440",
    "panel.border": "#3b4252",
    "panelTitle.activeBorder": "#88c0d0",
    "problemsErrorIcon.foreground": "#bf616a",
    "problemsWarningIcon.foreground": "#ebcb8b",

    "statusBar.background": "#3b4252",
    "statusBar.foreground": "#d8dee9",
    "statusBar.border": "#3b4252",

    "input.background": "#3b4252",
    "input.border": "#4c566a",
    "button.background": "#5e81ac",
    "button.hoverBackground": "#81a1c1",
    "quickInput.background": "#2e3440",
    "quickInput.border": "#4c566a",
    "scrollbarSlider.background": "#434c5e99",
    "scrollbarSlider.hoverBackground": "#4c566a",
    "welcome.logo": "#88c0d025",
    "welcome.titleForeground": "#4c566a"
  },

  "tokenColors": {
    "keyword": "#81a1c1",
    "keyword - control": "#81a1c1",
    "comment": { "foreground": "#616e88", "fontStyle": "italic" },
    "string": "#a3be8c",
    "string - escape character": "#ebcb8b",
    "number": "#b48ead",
    "class name": "#8fbcbb",
    "record class name": "#8fbcbb",
    "struct name": "#8fbcbb",
    "interface name": "#8fbcbb",
    "enum name": "#8fbcbb",
    "method name": "#88c0d0",
    "extension method name": "#88c0d0",
    "property name": "#d8dee9",
    "field name": "#d8dee9",
    "local name": "#d8dee9",
    "parameter name": "#d8dee9",
    "constant name": "#b48ead",
    "enum member name": "#b48ead",
    "operator": "#81a1c1",
    "punctuation": "#eceff4",
    "namespace name": "#d8dee9"
  },

  "metrics": {
    "tab.indicatorSize": 2,
    "list.radius": 3,
    "widget.radius": 4
  },

  "editor": {
    "renderWhitespace": "leading",
    "rulers": "100",
    "squiggleStyle": "line",
    "cursorBlinking": "blink"
  }
}
